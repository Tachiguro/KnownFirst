<Project Sdk="Microsoft.NET.Sdk.Razor" TreatAsLocalProperty="Configuration">

    <PropertyGroup>
        <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
        <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>KnownFirst</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <NeutralLanguage>en</NeutralLanguage>
        <Configurations>Debug;Release;BetaDiagnostic</Configurations>
        <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;KnownFirst.Core\**;KnownFirst.Application\**;KnownFirst.Tests\**;artifacts\**;temp\**;TestResults\**;.vs\**;**\*.log;**\*.binlog;scripts\tools\GermanLexiconGenerator\**</DefaultItemExcludes>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>KnownFirst</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.tachiguro.knownfirst</ApplicationId>

        <!-- Authoritative Product Identity -->
        <KnownFirstProductName>KnownFirst</KnownFirstProductName>
        <KnownFirstProductVersion>1.0.0-beta.13</KnownFirstProductVersion>
        <KnownFirstBuildNumber>15</KnownFirstBuildNumber>

        <ApplicationDisplayVersion>$(KnownFirstProductVersion)</ApplicationDisplayVersion>
        <ApplicationVersion>$(KnownFirstBuildNumber)</ApplicationVersion>
        <PackageVersion>$(KnownFirstProductVersion)</PackageVersion>
        <Version>$(KnownFirstProductVersion)</Version>

        <ApplicationDisplayVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">1.0.0</ApplicationDisplayVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!-- Microsoft-documented Windows App SDK workaround (WindowsAppSDK issue #3337): a Windows
         publish must be able to pin the RuntimeIdentifier from the command line. This bridge is
         inert unless RuntimeIdentifierOverride is supplied explicitly, so ordinary Debug/Release
         builds and every Android target framework are unaffected. .NET 10 removed the
         version-specific win10-* RIDs, so the portable win-x64 RID is the only supported value. -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
        <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
    </PropertyGroup>

    <!-- Opt-in Windows portable (unpackaged, self-contained) distribution variant. It changes
         nothing except where build output lands: WindowsPackageType stays None and the version
         identity stays exactly what an ordinary Windows Release build produces.

         Scope of the isolation guarantee: this redirects the KnownFirst application project only.
         A packaging publish therefore never rewrites this project's own bin\Release\... outputs,
         which are exactly the files backing the WindowsBuild and ValidateAll reusable-result
         records, so existing validation evidence for the main project cannot be silently
         invalidated. The referenced KnownFirst.Core project intentionally keeps its ordinary
         build and intermediate trees under the current design; that is deliberate and unchanged
         here, and no ValidateAll or WindowsBuild expected output points at Core.

         The matching intermediate-output root lives in Directory.Build.props, because an
         SDK-style project assigns that root too late for restore to follow it. -->
    <PropertyGroup Condition="'$(KnownFirstWindowsPortablePackaging)' == 'true' and '$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\build\windows-portable\</BaseOutputPath>
    </PropertyGroup>

    <!-- Opt-in Windows MSIX distribution variant.

         MAUI's GeneratePackageAppxManifest task replaces the Package.appxmanifest
         Identity/@Version="0.0.0.0" placeholder with
         <display[0]>.<display[1]>.<display[2]>.<ApplicationVersion>. With the ordinary Windows
         values (1.0.0 and 13) that yields 1.0.0.13, which the Microsoft Store rejects: the
         fourth section is reserved for Store use and must be 0. The build number is therefore
         carried in the third section instead, giving the deterministic mapping

             MSIX package version = $(KnownFirstWindowsPackageMajorMinor).$(KnownFirstBuildNumber).0

         which is 1.0.13.0 for build 13. Because KnownFirstBuildNumber is strictly monotonically
         increasing for every distributable package (docs/VERSIONING.md), successive MSIX package
         versions are strictly increasing and cannot collide.

         KnownFirstProductVersion and KnownFirstBuildNumber are untouched, and the runtime
         identity string is read from the KnownFirstProductVersion/KnownFirstBuildNumber
         AssemblyMetadata attributes rather than from ApplicationDisplayVersion/ApplicationVersion,
         so this remapping is invisible to the running application. -->
    <PropertyGroup Condition="'$(KnownFirstWindowsMsixPackaging)' == 'true' and '$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\build\windows-msix\</BaseOutputPath>
        <KnownFirstWindowsPackageMajorMinor>1.0</KnownFirstWindowsPackageMajorMinor>
        <ApplicationDisplayVersion>$(KnownFirstWindowsPackageMajorMinor).$(KnownFirstBuildNumber)</ApplicationDisplayVersion>
        <ApplicationVersion>0</ApplicationVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <Optimize>true</Optimize>
        <PublishTrimmed>true</PublishTrimmed>
        <RunAOTCompilation>true</RunAOTCompilation>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidPackageFormats>apk</AndroidPackageFormats>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'BetaDiagnostic'">
        <DefineConstants>$(DefineConstants);KNOWNFIRST_DIAGNOSTICS</DefineConstants>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    </PropertyGroup>

    <!-- GUI test profile isolation (KNOWNFIRST_GUI_TEST_ROOT) is only supported in Windows Debug
         and Windows BetaDiagnostic builds; Windows Release and every Android configuration must
         fail closed instead of silently isolating (or worse, not isolating) real application data. -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and ('$(Configuration)' == 'Debug' or '$(Configuration)' == 'BetaDiagnostic')">
        <DefineConstants>$(DefineConstants);KNOWNFIRST_GUI_TEST_PROFILE_SUPPORTED</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'BetaDiagnostic' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <ApplicationTitle>KnownFirst Diagnostic</ApplicationTitle>
        <ApplicationId>com.tachiguro.knownfirst.diagnostic</ApplicationId>
        <Optimize>true</Optimize>
        <PublishTrimmed>true</PublishTrimmed>
        <RunAOTCompilation>true</RunAOTCompilation>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidPackageFormats>apk</AndroidPackageFormats>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <ApplicationTitle>KnownFirst Debug</ApplicationTitle>
        <ApplicationId>com.tachiguro.knownfirst.debug</ApplicationId>
        <Optimize>false</Optimize>
        <PublishTrimmed>false</PublishTrimmed>
        <RunAOTCompilation>false</RunAOTCompilation>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidUseFastDeployment>false</AndroidUseFastDeployment>
        <AndroidPackageFormats>apk</AndroidPackageFormats>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
    </PropertyGroup>

    <!-- P16-A: this is an opt-in Android Debug derivative, never a normal Debug build. Its
         package-private profile is the only Android GUI-test data root; it must not share normal
         Debug output/intermediate paths or package identity. -->
    <PropertyGroup Condition="'$(KnownFirstAndroidGuiTest)' == 'true' and '$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <ApplicationTitle>KnownFirst GUI Test</ApplicationTitle>
        <ApplicationId>com.tachiguro.knownfirst.guitest</ApplicationId>
        <DefineConstants>$(DefineConstants);KNOWNFIRST_ANDROID_GUI_TEST</DefineConstants>
        <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\build\android-gui-test\</BaseOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
        <DefaultItemExcludes>$(DefaultItemExcludes);Components\Pages\Diagnostics.razor;Components\Pages\Diagnostics.razor.css</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.png" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'" />
        <MauiIcon Include="Resources\AppIcon\appicon_windows.png" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    </ItemGroup>

    <ItemGroup>
        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\AppIcon\appicon.png" Color="#14274f" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- German Enhanced Term Recognition (Package 2): the single approved Package-1
             production German morphology lexicon bundle, embedded directly into this assembly
             under one explicit, stable resource name — never assembly/resource scanning, never a
             loose file the app reads by mutable path. No per-target-framework condition, so the
             same single bundle ships for both Windows and Android. See
             Services\Lexical\BundledGermanLexicon.cs. -->
        <EmbeddedResource Include="KnownFirst.Core\Text\German\Assets\german-lexicon.v2.kfgl"
                           LogicalName="KnownFirst.Resources.German.german-lexicon.v2.kfgl" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AngleSharp" Version="1.5.2" />
        <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.10" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="KnownFirst.Application\KnownFirst.Application.csproj" />
        <ProjectReference Include="KnownFirst.Core\KnownFirst.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
        <Content Remove="Components\Pages\Diagnostics.razor" />
        <Content Remove="Components\Pages\Diagnostics.razor.css" />
        <Compile Remove="Services\Study\DebugLearningClock.cs" />
        <RazorComponent Remove="Components\Pages\Diagnostics.razor" />
        <None Remove="Components\Pages\Diagnostics.razor" />
        <None Remove="Components\Pages\Diagnostics.razor.css" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyMetadata Include="KnownFirstProductName" Value="$(KnownFirstProductName)" />
        <AssemblyMetadata Include="KnownFirstProductVersion" Value="$(KnownFirstProductVersion)" />
        <AssemblyMetadata Include="KnownFirstBuildNumber" Value="$(KnownFirstBuildNumber)" />
    </ItemGroup>

    <Target Name="InjectGitMetadata" BeforeTargets="GetAssemblyAttributes">
        <Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="Low" StandardErrorImportance="Low" IgnoreExitCode="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
        </Exec>
        <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="Low" StandardErrorImportance="Low" IgnoreExitCode="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitShortCommitHash" />
        </Exec>
        <Exec Command="git branch --show-current" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="Low" StandardErrorImportance="Low" IgnoreExitCode="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitBranchName" />
        </Exec>
        <Exec Command="git status --porcelain" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="Low" StandardErrorImportance="Low" IgnoreExitCode="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitStatusOutput" />
        </Exec>

        <PropertyGroup>
            <GitCommitHash Condition="'$(GitCommitHash)' == '' or $(GitCommitHash.Contains('fatal'))">unknown</GitCommitHash>
            <GitShortCommitHash Condition="'$(GitShortCommitHash)' == '' or $(GitShortCommitHash.Contains('fatal'))">unknown</GitShortCommitHash>
            <GitBranchName Condition="'$(GitBranchName)' == '' or $(GitBranchName.Contains('fatal'))">unknown</GitBranchName>
            <GitIsDirty Condition="'$(GitStatusOutput)' != ''">true</GitIsDirty>
            <GitIsDirty Condition="'$(GitStatusOutput)' == ''">false</GitIsDirty>
        </PropertyGroup>

        <ItemGroup>
            <AssemblyMetadata Include="GitCommitHash" Value="$(GitCommitHash)" />
            <AssemblyMetadata Include="GitShortCommitHash" Value="$(GitShortCommitHash)" />
            <AssemblyMetadata Include="GitBranchName" Value="$(GitBranchName)" />
            <AssemblyMetadata Include="GitIsDirty" Value="$(GitIsDirty)" />
        </ItemGroup>
    </Target>

</Project>
