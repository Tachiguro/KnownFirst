@namespace KnownFirst.Components.Onboarding.Steps
@using KnownFirst.Services
@inject IAppSettingsService AppSettings
@inject IStringLocalizer<SharedResource> Localizer

<div class="onboarding-step onboarding-online-lookup-step">
    <h1 class="onboarding-title" id="onboarding-online-lookup-title">@Localizer["Onboarding_OnlineLookupTitle"]</h1>
    <p class="onboarding-concept">@Localizer["Onboarding_OnlineLookupDescription"]</p>

    <section class="onboarding-card" aria-labelledby="onboarding-online-lookup-title">
        <div class="onboarding-service-highlights" role="list">
            <p class="setting-help" role="listitem">
                <strong>Wiktionary:</strong> @Localizer["Onboarding_OnlineLookupServiceWiktionary"]
            </p>
            <p class="setting-help" role="listitem">
                <strong>Wikipedia:</strong> @Localizer["Onboarding_OnlineLookupServiceWikipedia"]
            </p>
            <p class="setting-help" role="listitem">
                @Localizer["Onboarding_OnlineLookupPrivacyNotice"]
            </p>
        </div>

        <div class="choice-grid choice-grid-two" role="group" aria-labelledby="onboarding-online-lookup-title">
            <button type="button"
                    id="onboarding-online-consent-enable-button"
                    class="choice-button @(_explicitConsentChoice == true ? "active" : null)"
                    aria-pressed="@(_explicitConsentChoice == true)"
                    @onclick="EnableOnlineConsent">
                @Localizer["Onboarding_OnlineLookupEnable"]
            </button>
            <button type="button"
                    id="onboarding-online-consent-disable-button"
                    class="choice-button @(_explicitConsentChoice == false ? "active" : null)"
                    aria-pressed="@(_explicitConsentChoice == false)"
                    @ref="_onlineConsentRevokeButton"
                    @onclick="DisableOnlineConsent">
                @Localizer["Onboarding_OnlineLookupKeepDisabled"]
            </button>
        </div>

        @if (_showOnlineConsentRevokeConfirmation)
        {
            <div id="onboarding-online-consent-revoke-confirmation"
                 class="destructive-confirmation"
                 role="alertdialog"
                 aria-labelledby="onboarding-online-consent-revoke-confirmation-message"
                 @onkeydown="HandleOnlineConsentRevokeDialogKeyDown">
                <p id="onboarding-online-consent-revoke-confirmation-message">
                    @Localizer["Settings_RevokeOnlineConsentConfirmMessage"]
                </p>
                <div class="button-row">
                    <button type="button"
                            id="onboarding-online-consent-revoke-cancel-button"
                            class="button button-secondary"
                            @ref="_cancelOnlineConsentRevokeButton"
                            @onclick="CancelOnlineConsentRevocation">
                        @Localizer["Common_Cancel"]
                    </button>
                    <button type="button"
                            id="onboarding-online-consent-revoke-confirm-button"
                            class="button button-danger"
                            data-destructive-confirm
                            @onclick="ConfirmOnlineConsentRevocation">
                        @Localizer["Settings_RevokeOnlineConsent"]
                    </button>
                </div>
            </div>
        }
    </section>

    <div class="onboarding-actions">
        <button type="button"
                id="onboarding-online-lookup-continue-button"
                class="button button-primary onboarding-continue-button"
                disabled="@(_explicitConsentChoice is null)"
                @onclick="OnContinue">
            @Localizer["Common_Continue"]
        </button>
        <button type="button"
                id="onboarding-online-lookup-back-button"
                class="button button-secondary onboarding-back-button"
                @onclick="OnBack">
            @Localizer["Common_Back"]
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnContinue { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private bool? _explicitConsentChoice;
    private bool _showOnlineConsentRevokeConfirmation;
    private bool _revealOnlineConsentRevokeConfirmation;
    private bool _returnFocusToOnlineConsentRevokeButton;
    private ElementReference _onlineConsentRevokeButton;
    private ElementReference _cancelOnlineConsentRevokeButton;

    protected override void OnInitialized()
    {
        if (AppSettings.HasOnlineLookupConsent)
        {
            _explicitConsentChoice = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_revealOnlineConsentRevokeConfirmation)
        {
            _revealOnlineConsentRevokeConfirmation = false;
            await _cancelOnlineConsentRevokeButton.FocusAsync(preventScroll: true);
        }
        else if (_returnFocusToOnlineConsentRevokeButton)
        {
            _returnFocusToOnlineConsentRevokeButton = false;
            await _onlineConsentRevokeButton.FocusAsync();
        }
    }

    private void EnableOnlineConsent()
    {
        AppSettings.GrantOnlineLookupConsent();
        _explicitConsentChoice = true;
        _showOnlineConsentRevokeConfirmation = false;
    }

    private void DisableOnlineConsent()
    {
        if (AppSettings.HasOnlineLookupConsent)
        {
            ShowOnlineConsentRevokeConfirmation();
        }
        else
        {
            _explicitConsentChoice = false;
        }
    }

    private void ShowOnlineConsentRevokeConfirmation()
    {
        _showOnlineConsentRevokeConfirmation = true;
        _revealOnlineConsentRevokeConfirmation = true;
    }

    private void CancelOnlineConsentRevocation()
    {
        _showOnlineConsentRevokeConfirmation = false;
        _returnFocusToOnlineConsentRevokeButton = true;
    }

    private void HandleOnlineConsentRevokeDialogKeyDown(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Escape")
        {
            CancelOnlineConsentRevocation();
        }
    }

    private void ConfirmOnlineConsentRevocation()
    {
        AppSettings.RevokeOnlineLookupConsent();
        _showOnlineConsentRevokeConfirmation = false;
        _explicitConsentChoice = false;
    }
}
