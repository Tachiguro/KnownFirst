@page "/settings"
@implements IAsyncDisposable
@using KnownFirst.Models.Backup
@inject ILanguageSelectionService LanguageSelection
@inject IThemeService ThemeService
@inject IAppSettingsService AppSettings
@inject ISettingsFeedbackService SettingsFeedback
@inject KnownFirst.Data.IKnownFirstDatabase Database
@inject ILogger<Settings> Logger
@inject IJSRuntime JsRuntime
@inject ITextReviewService TextReviewService
@inject KnownFirst.Services.Lexical.ILexicalDiagnosticLog LexicalDiagnosticLog
@inject KnownFirst.Services.Diagnostics.IBuildIdentityService BuildIdentityService
@inject KnownFirst.Services.Diagnostics.IBugReportLauncherService BugReportLauncher
@inject IBackupService BackupService
@inject IPortableArchiveFileService PortableArchiveFiles
@inject KnownFirst.Services.Study.IWorkflowChangeNotifier WorkflowChangeNotifier
@inject KnownFirst.Services.Settings.ISettingsDefaultsService SettingsDefaults
@inject KnownFirst.Services.Time.ILearningTimezoneResolver LearningTimezoneResolver
@inject Microsoft.Maui.Storage.IPreferences Preferences

<PageTitle>@Localizer["Settings_Title"]</PageTitle>

<section class="settings-page">
    <PageHeader Title="@(Localizer["Settings_Title"])"
                BackHref="@(_hasActiveReview ? "review-words" : string.Empty)" />

    @if (_hasActiveReview)
    {
        <a class="button button-secondary" href="review-words">@Localizer["Settings_ReturnToReview"]</a>
    }

    <section class="settings-card" aria-labelledby="language-setting-title">
        <h2 id="language-setting-title">
            <label for="ui-language-select">@Localizer["Settings_UILanguage"]</label>
        </h2>
        <div class="field-group">
            <select id="ui-language-select"
                    disabled="@_isChangingLanguage"
                    @bind="_selectedLanguagePreference"
                    @bind:after="HandleUiLanguagePreferenceChanged">
                <option value="@LanguageSelectionService.SystemPreferenceCode">@Localizer["Settings_UILanguageSystem"]</option>
                <option value="@LanguageSelectionService.EnglishLanguageCode">@Localizer["Settings_English"]</option>
                <option value="@LanguageSelectionService.GermanLanguageCode">@Localizer["Settings_German"]</option>
                <option value="@LanguageSelectionService.RussianLanguageCode">@Localizer["Settings_Russian"]</option>
            </select>
        </div>
        @if (_languageConfirmation is not null)
        {
            <p class="setting-feedback setting-feedback-success" role="status" aria-live="polite">
                @Localizer[GetLanguageConfirmationKey(_languageConfirmation)]
            </p>
        }
        else if (_languageChangeFailed)
        {
            <p class="setting-feedback setting-feedback-error" role="alert">@Localizer["Settings_SaveError"]</p>
        }
    </section>

    <section class="settings-card" aria-labelledby="appearance-setting-title">
        <h2 id="appearance-setting-title">@Localizer["Settings_Appearance"]</h2>
        <div class="choice-grid choice-grid-three">
            <button type="button"
                    class="choice-button @(IsThemeSelected(ThemePreference.System) ? "active" : null)"
                    aria-pressed="@IsThemeSelected(ThemePreference.System)"
                    @onclick="() => SelectTheme(ThemePreference.System)">
                @Localizer["Settings_AppearanceSystem"]
            </button>
            <button type="button"
                    class="choice-button @(IsThemeSelected(ThemePreference.Light) ? "active" : null)"
                    aria-pressed="@IsThemeSelected(ThemePreference.Light)"
                    @onclick="() => SelectTheme(ThemePreference.Light)">
                @Localizer["Settings_AppearanceLight"]
            </button>
            <button type="button"
                    class="choice-button @(IsThemeSelected(ThemePreference.Dark) ? "active" : null)"
                    aria-pressed="@IsThemeSelected(ThemePreference.Dark)"
                    @onclick="() => SelectTheme(ThemePreference.Dark)">
                @Localizer["Settings_AppearanceDark"]
            </button>
        </div>
        @if (_appearanceConfirmation is not null)
        {
            <p class="setting-feedback setting-feedback-success" role="status" aria-live="polite">
                @Localizer["Settings_AppearanceChangedTo", GetAppearanceDisplayName(_appearanceConfirmation.Value)]
            </p>
        }
        else if (_appearanceChangeFailed)
        {
            <p class="setting-feedback setting-feedback-error" role="alert">@Localizer["Settings_SaveError"]</p>
        }
    </section>

    <section class="settings-card" aria-labelledby="preparation-limit-title">
        <h2 id="preparation-limit-title">
            <label for="preparation-limit">@Localizer["Settings_PreparationLimit"]</label>
        </h2>
        <p id="preparation-limit-help" class="setting-help">@Localizer["Settings_PreparationLimitHelp"]</p>
        <div class="field-group">
            <select id="preparation-limit"
                    aria-describedby="preparation-limit-help"
                    @bind="_selectedPreparationLimit"
                    @bind:after="SavePreparationLimit">
                @foreach (var limit in AppSettings.SupportedPreparationLimits)
                {
                    <option value="@limit">@limit</option>
                }
            </select>
        </div>
        @if (_preparationLimitConfirmation is not null)
        {
            <p class="setting-feedback setting-feedback-success" role="status" aria-live="polite">
                @Localizer["Settings_PreparationLimitSaved", _preparationLimitConfirmation.Value]
            </p>
        }
        else if (_preparationLimitChangeFailed)
        {
            <p class="setting-feedback setting-feedback-error" role="alert">@Localizer["Settings_SaveError"]</p>
        }
    </section>

    <section class="settings-card" aria-labelledby="learning-timezone-title">
        <h2 id="learning-timezone-title">
            <label for="learning-timezone-select">@Localizer["Settings_LearningTimezone"]</label>
        </h2>
        <p id="learning-timezone-help" class="setting-help">@Localizer["Settings_LearningTimezoneHelp"]</p>
        <div class="field-group">
            <select id="learning-timezone-select"
                    aria-describedby="learning-timezone-help"
                    @bind="_selectedLearningTimezoneValue"
                    @bind:after="SelectLearningTimezone">
                <option value="@SystemLearningTimezoneValue">@Localizer["Settings_LearningTimezoneSystem"]</option>
                @foreach (var option in LearningTimezoneCatalog.Options)
                {
                    <option value="@option.TimezoneId">@GetLearningTimezoneOptionLabel(option)</option>
                }
            </select>
        </div>
        <p id="learning-timezone-effective" class="setting-help">
            @Localizer["Settings_LearningTimezoneEffective", EffectiveLearningTimezoneOffsetLabel]
        </p>
        @if (_learningTimezoneSaved)
        {
            <p class="setting-feedback setting-feedback-success" role="status" aria-live="polite">
                @Localizer["Settings_LearningTimezoneSaved"]
            </p>
        }
    </section>

    <section class="settings-card" aria-labelledby="learning-day-cutoff-title">
        <h2 id="learning-day-cutoff-title">
            <label for="learning-day-cutoff-input">@Localizer["Settings_LearningDayCutoff"]</label>
        </h2>
        <p id="learning-day-cutoff-help" class="setting-help">@Localizer["Settings_LearningDayCutoffHelp"]</p>
        <div class="field-group">
            @* The raw HH:mm string is handled directly instead of through @bind so the stored
               cutoff stays an exact, culture-independent minute value. *@
            <input id="learning-day-cutoff-input"
                   type="time"
                   step="60"
                   aria-describedby="learning-day-cutoff-help"
                   value="@_selectedLearningDayCutoffText"
                   @onchange="SaveLearningDayCutoff" />
        </div>
        @if (_learningDayCutoffSaved)
        {
            <p class="setting-feedback setting-feedback-success" role="status" aria-live="polite">
                @Localizer["Settings_LearningDayCutoffSaved"]
            </p>
        }
    </section>

    <section class="settings-card" aria-labelledby="card-direction-title">
        <h2 id="card-direction-title">@Localizer["Settings_CardDirection"]</h2>
        <div class="choice-grid choice-grid-three">
            <button type="button"
                    class="choice-button @(_selectedCardDirection == CardDirectionPreference.TermToMeaning ? "active" : null)"
                    aria-pressed="@(_selectedCardDirection == CardDirectionPreference.TermToMeaning)"
                    @onclick="() => SelectCardDirection(CardDirectionPreference.TermToMeaning)">
                @Localizer["Settings_CardDirectionTermToMeaning"]
            </button>
            <button type="button"
                    class="choice-button @(_selectedCardDirection == CardDirectionPreference.MeaningToTerm ? "active" : null)"
                    aria-pressed="@(_selectedCardDirection == CardDirectionPreference.MeaningToTerm)"
                    @onclick="() => SelectCardDirection(CardDirectionPreference.MeaningToTerm)">
                @Localizer["Settings_CardDirectionMeaningToTerm"]
            </button>
            <button type="button"
                    class="choice-button @(_selectedCardDirection == CardDirectionPreference.Both ? "active" : null)"
                    aria-pressed="@(_selectedCardDirection == CardDirectionPreference.Both)"
                    @onclick="() => SelectCardDirection(CardDirectionPreference.Both)">
                @Localizer["Settings_CardDirectionBoth"]
            </button>
        </div>
        @if (_cardDirectionSaved)
        {
            <p class="setting-feedback setting-feedback-success" role="status">
                @Localizer["Settings_CardDirectionSaved"]
            </p>
        }
    </section>

    <section class="settings-card" aria-labelledby="learning-mode-title">
        <h2 id="learning-mode-title">@Localizer["Settings_LearningMode"]</h2>
        <p class="setting-help">@Localizer["Settings_LearningModeHelp"]</p>
        <div class="choice-grid choice-grid-three">
            <button type="button"
                    class="choice-button @(_selectedLearningMode == LearningMode.Reading ? "active" : null)"
                    aria-pressed="@(_selectedLearningMode == LearningMode.Reading)"
                    @onclick="() => SelectLearningMode(LearningMode.Reading)">
                @Localizer["Settings_LearningModeReading"]
            </button>
            <button type="button"
                    class="choice-button @(_selectedLearningMode == LearningMode.Typing ? "active" : null)"
                    aria-pressed="@(_selectedLearningMode == LearningMode.Typing)"
                    @onclick="() => SelectLearningMode(LearningMode.Typing)">
                @Localizer["Settings_LearningModeTyping"]
            </button>
            <button type="button"
                    class="choice-button @(_selectedLearningMode == LearningMode.Automatic ? "active" : null)"
                    aria-pressed="@(_selectedLearningMode == LearningMode.Automatic)"
                    @onclick="() => SelectLearningMode(LearningMode.Automatic)">
                @Localizer["Settings_LearningModeAutomatic"]
            </button>
        </div>
        @if (_learningModeSaved)
        {
            <p class="setting-feedback setting-feedback-success" role="status">
                @Localizer["Settings_LearningModeSaved"]
            </p>
        }
    </section>

    <section class="settings-card" aria-labelledby="enhanced-term-recognition-title">
        <h2 id="enhanced-term-recognition-title">@Localizer["Settings_EnhancedTermRecognition"]</h2>
        <p id="enhanced-term-recognition-help" class="setting-help">@Localizer["Settings_EnhancedTermRecognitionHelp"]</p>
        <div class="choice-grid choice-grid-two" role="group" aria-describedby="enhanced-term-recognition-help">
            <button type="button"
                    id="enhanced-term-recognition-on-button"
                    class="choice-button @(_enhancedTermRecognitionEnabled ? "active" : null)"
                    aria-pressed="@_enhancedTermRecognitionEnabled"
                    @onclick="() => SetEnhancedTermRecognition(true)">
                @Localizer["Settings_EnhancedTermRecognitionOn"]
            </button>
            <button type="button"
                    id="enhanced-term-recognition-off-button"
                    class="choice-button @(!_enhancedTermRecognitionEnabled ? "active" : null)"
                    aria-pressed="@(!_enhancedTermRecognitionEnabled)"
                    @onclick="() => SetEnhancedTermRecognition(false)">
                @Localizer["Settings_EnhancedTermRecognitionOff"]
            </button>
        </div>
        @if (_enhancedTermRecognitionSaved)
        {
            <p class="setting-feedback setting-feedback-success" role="status">
                @Localizer["Settings_EnhancedTermRecognitionSaved"]
            </p>
        }
    </section>

    <section class="settings-card" aria-labelledby="restore-defaults-title">
        <h2 id="restore-defaults-title">@Localizer["Settings_RestoreDefaults"]</h2>
        <p class="setting-help">@Localizer["Settings_RestoreDefaultsDescription"]</p>
        @if (!_showRestoreDefaultsConfirmation)
        {
            <button id="restore-defaults-button"
                    type="button"
                    class="button button-secondary"
                    @ref="_restoreDefaultsButton"
                    @onclick="ShowRestoreDefaultsConfirmation">
                @Localizer["Settings_RestoreDefaults"]
            </button>
        }
        else
        {
            <div id="restore-defaults-confirmation"
                 class="restore-defaults-confirmation"
                 role="group"
                 aria-labelledby="restore-defaults-confirmation-message"
                 @onkeydown="HandleRestoreDefaultsDialogKeyDown">
                <p id="restore-defaults-confirmation-message">@Localizer["Settings_RestoreDefaultsConfirmMessage"]</p>
                <div class="button-row">
                    <button id="restore-defaults-cancel-button"
                            type="button"
                            class="button button-secondary"
                            @ref="_cancelRestoreDefaultsButton"
                            @onclick="CancelRestoreDefaults">
                        @Localizer["Common_Cancel"]
                    </button>
                    <button id="restore-defaults-confirm-button"
                            type="button"
                            class="button button-primary"
                            @onclick="RestoreDefaults">
                        @Localizer["Settings_RestoreDefaultsConfirmAction"]
                    </button>
                </div>
            </div>
        }

        @if (_restoreDefaultsSucceeded)
        {
            <p id="restore-defaults-success" class="setting-feedback setting-feedback-success" role="status" aria-live="polite">
                @Localizer["Settings_RestoreDefaultsSuccess"]
            </p>
        }
        else if (_restoreDefaultsFailed)
        {
            <p id="restore-defaults-error" class="setting-feedback setting-feedback-error" role="alert">
                @Localizer["Settings_RestoreDefaultsError"]
            </p>
        }
    </section>

    <section class="settings-card" aria-labelledby="online-lookup-title">
        <h2 id="online-lookup-title">@Localizer["Settings_OnlineDictionary"]</h2>
        <p>@Localizer[AppSettings.HasOnlineLookupConsent
            ? "Settings_OnlineConsentGranted"
            : "Settings_OnlineConsentNotGranted"]</p>
        @if (AppSettings.HasOnlineLookupConsent)
        {
            <button type="button" class="button button-secondary" @onclick="RevokeOnlineConsent">
                @Localizer["Settings_RevokeOnlineConsent"]
            </button>
        }
        else
        {
            <h3>@Localizer["Prepare_OnlineDisclosureTitle"]</h3>
            <p class="setting-help">@Localizer["Prepare_OnlineDisclosure"]</p>
            <button type="button" class="button button-primary" @onclick="ActivateOnlineConsent">
                @Localizer["Settings_ActivateOnlineConsent"]
            </button>
        }
        @if (_onlineConsentRevoked)
        {
            <p class="setting-feedback setting-feedback-success" role="status">
                @Localizer["Settings_OnlineConsentRevoked"]
            </p>
        }
        @if (_onlineConsentActivated)
        {
            <p class="setting-feedback setting-feedback-success" role="status">
                @Localizer["Settings_OnlineConsentActivated"]
            </p>
        }
    </section>

    <section class="settings-card" aria-labelledby="portable-data-title">
        <h2 id="portable-data-title">@Localizer["Settings_PortableData"]</h2>
        <p>@Localizer["Settings_PortableDataDescription"]</p>
        <p class="setting-help">@Localizer["Settings_PortableDataPrivacyNotice"]</p>
        @if (_portableImportPreview is null)
        {
            <div class="support-actions">
                <button type="button"
                        id="portable-data-export-button"
                        class="button button-secondary"
                        disabled="@_isPortableDataOperation"
                        @onclick="ExportPortableDataAsync">
                    @Localizer["Settings_DataExport"]
                </button>
                <button type="button"
                        id="portable-data-import-button"
                        class="button button-secondary"
                        disabled="@_isPortableDataOperation"
                        @ref="_dataImportButton"
                        @onclick="ChoosePortableImportAsync">
                    @Localizer["Settings_DataImport"]
                </button>
            </div>
        }

        @if (_portableImportPreview is { } preview && _portableImportSelection is not null)
        {
            <div id="portable-import-preview-panel"
                 class="import-preview-panel"
                 role="alertdialog"
                 aria-labelledby="portable-import-preview-title"
                 @ref="_importPreviewElement"
                 @onkeydown="HandleImportPreviewKeyDown">
                <p id="portable-import-preview-title">
                    @Localizer[GetImportPreviewTitleKey(preview.Disposition), _portableImportSelection.DisplayName]
                </p>
                <p class="setting-help">@Localizer[GetImportPreviewDescriptionKey(preview.Disposition)]</p>

                @if (preview.Disposition == PortableImportPreviewDisposition.MergeChanges)
                {
                    <ul class="import-preview-counts">
                        <li>@Localizer["Settings_DataImportPreviewCountsNew", preview.InsertedCount]</li>
                        <li>@Localizer["Settings_DataImportPreviewCountsEnriched", preview.EnrichedCount]</li>
                        <li>@Localizer["Settings_DataImportPreviewCountsPreserved", preview.PreservedVariantCount]</li>
                        <li>@Localizer["Settings_DataImportPreviewCountsSkipped", preview.SkippedCount]</li>
                    </ul>
                    <p class="setting-help">@Localizer["Settings_DataImportPreviewMergeSafetyCopyNotice"]</p>
                }

                <div class="button-row">
                    @if (preview.CanConfirm)
                    {
                        <button type="button"
                                id="portable-import-cancel-button"
                                class="button button-secondary"
                                disabled="@_isPortableDataOperation"
                                @ref="_cancelImportPreviewButton"
                                @onclick="CancelPortableImportAsync">
                            @Localizer["Common_Cancel"]
                        </button>
                        <button type="button"
                                id="portable-import-confirm-button"
                                class="button button-primary"
                                disabled="@_isPortableDataOperation"
                                @onclick="ConfirmPortableImportAsync">
                            @Localizer[GetImportConfirmActionKey(preview.Disposition)]
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                id="portable-import-cancel-button"
                                class="button button-secondary"
                                disabled="@_isPortableDataOperation"
                                @ref="_cancelImportPreviewButton"
                                @onclick="CancelPortableImportAsync">
                            @Localizer["Common_Close"]
                        </button>
                    }
                </div>
            </div>
        }

        @if (_portableDataMessageKey is not null)
        {
            <p id="@(_portableDataOperationFailed ? "portable-data-result-message-error" : "portable-data-result-message-success")"
               class="setting-feedback @(_portableDataOperationFailed ? "setting-feedback-error" : "setting-feedback-success")"
               role="@(_portableDataOperationFailed ? "alert" : "status")"
               aria-live="polite">
                @Localizer[_portableDataMessageKey]
            </p>
            @if (_portableImportResultSummary is { Disposition: PortableImportDisposition.MergeApplied } mergeSummary)
            {
                <ul class="import-preview-counts">
                    <li>@Localizer["Settings_DataImportPreviewCountsNew", mergeSummary.InsertedCount]</li>
                    <li>@Localizer["Settings_DataImportPreviewCountsEnriched", mergeSummary.EnrichedCount]</li>
                    <li>@Localizer["Settings_DataImportPreviewCountsPreserved", mergeSummary.PreservedVariantCount]</li>
                    <li>@Localizer["Settings_DataImportPreviewCountsSkipped", mergeSummary.SkippedCount]</li>
                </ul>
                @if (mergeSummary.SafetyCopyCreated)
                {
                    <p class="setting-help">@Localizer["Settings_DataImportResultMergeAppliedSafetyCopyNotice"]</p>
                }
            }
        }
    </section>

    @if (DiagnosticsEnabled)
    {
        <section class="settings-card debug-tools" aria-labelledby="lexical-diagnostics-title">
            <h2 id="lexical-diagnostics-title"><span class="debug-label">@Localizer["Diagnostics_DebugLabel"]</span> @Localizer["Diagnostics_LexicalLogTitle"]</h2>
            <p>@Localizer["Diagnostics_LexicalLogDescription"]</p>
            <div class="support-actions">
                <button type="button" class="button button-debug" disabled="@_isChangingDiagnostics" @onclick="CopyLexicalDiagnosticReportAsync">
                    @Localizer["Diagnostics_CopyDiagnosticReport"]
                </button>
                <button type="button" class="button button-debug" disabled="@_isChangingDiagnostics" @onclick="ExportLexicalDiagnosticLogAsync">
                    @Localizer["Diagnostics_ExportDiagnosticLog"]
                </button>
                <button type="button" class="button button-debug" disabled="@_isChangingDiagnostics" @onclick="ClearLexicalDiagnosticLogAsync">
                    @Localizer["Diagnostics_ClearDiagnosticLog"]
                </button>
            </div>
            @if (_diagnosticMessageKey is not null)
            {
                <p class="setting-feedback @(_diagnosticActionFailed ? "setting-feedback-error" : "setting-feedback-success")"
                   role="status"
                   aria-live="polite">
                    @Localizer[_diagnosticMessageKey]
                </p>
            }
        </section>
    }

    <section class="settings-card" aria-labelledby="help-and-support-title">
        <h2 id="help-and-support-title">@Localizer["Settings_HelpAndSupport"]</h2>
        <div class="support-actions">
            <a id="settings-release-notes-link" class="button button-secondary" href="release-notes">@Localizer["WhatsNew_Title"]</a>
            <button type="button"
                    id="settings-report-bug-button"
                    class="button button-secondary"
                    disabled="@_isLaunchingBugReport"
                    @onclick="ReportBugAsync">
                @Localizer["Settings_ReportBug"]
            </button>
        </div>
        @if (_bugReportFailed)
        {
            <div id="bug-report-fallback-panel" class="setting-feedback setting-feedback-error" role="alert">
                <p id="bug-report-feedback-error">@Localizer["Settings_ReportBugError"]</p>
                <p id="bug-report-address" class="setting-help" style="margin-top: 0.5rem; margin-bottom: 0.5rem; user-select: all;">
                    @BugReportLauncher.RecipientEmail
                </p>
                <div class="button-row">
                    <button type="button"
                            id="settings-copy-bug-report-address-button"
                            class="button button-secondary"
                            disabled="@_isCopyingBugReportAddress"
                            @onclick="CopyBugReportAddressAsync">
                        @Localizer["Settings_CopyBugReportAddress"]
                    </button>
                </div>
                @if (_bugReportAddressCopied)
                {
                    <p id="bug-report-copy-success" class="setting-feedback setting-feedback-success" role="status" aria-live="polite">
                        @Localizer["Settings_BugReportAddressCopied"]
                    </p>
                }
                else if (_bugReportAddressCopyFailed)
                {
                    <p id="bug-report-copy-error" class="setting-feedback setting-feedback-error" role="alert">
                        @Localizer["Settings_BugReportAddressCopyError"]
                    </p>
                }
            </div>
        }

        <p style="margin-top: 1rem; font-size: 0.8rem; opacity: 0.7;">
            @BuildIdentityService.GetFormattedBuildIdentity()
        </p>
    </section>

    <section class="settings-card danger-zone" aria-labelledby="reset-data-title">
        <h2 id="reset-data-title">@Localizer["Settings_ResetData"]</h2>
        <p>@Localizer["Settings_ResetDescription"]</p>
        @if (!_showResetConfirmation)
        {
            <button id="reset-data-button"
                    type="button"
                    class="button button-danger"
                    @ref="_resetButton"
                    @onclick="ShowResetConfirmation">
                @Localizer["Settings_ResetData"]
            </button>
        }
        else
        {
            <div class="destructive-confirmation"
                 role="alertdialog"
                 aria-labelledby="reset-confirmation-message"
                 @ref="_resetConfirmation"
                 @onkeydown="HandleResetDialogKeyDown">
                <p id="reset-confirmation-message">@Localizer["Settings_ResetConfirmMessage"]</p>
                <div class="button-row">
                    <button id="reset-confirm-cancel-button"
                            type="button"
                            class="button button-secondary"
                            disabled="@_isResetting"
                            @ref="_cancelResetButton"
                            @onclick="CancelReset">
                        @Localizer["Common_Cancel"]
                    </button>
                    <button id="reset-confirm-confirm-button"
                            type="button"
                            class="button button-danger"
                            data-destructive-confirm
                            disabled="@_isResetting"
                            @onclick="ResetDataAsync">
                        @Localizer["Settings_ResetConfirmAction"]
                    </button>
                </div>
                @if (_resetFailed)
                {
                    <p class="inline-message inline-message-error" role="alert">@Localizer["Settings_ResetError"]</p>
                }
            </div>
        }

        @if (_resetSucceeded)
        {
            <p class="inline-message inline-message-success" role="status" aria-live="polite">
                @Localizer["Settings_ResetSuccess"]
            </p>
        }
    </section>
</section>

@code {
    private const string SystemLearningTimezoneValue = "system";

    private string _selectedLanguagePreference = LanguageSelectionService.EnglishLanguageCode;
    private ThemePreference _selectedTheme = ThemePreference.System;
    private int _selectedPreparationLimit = AppSettingsService.DefaultPreparationLimit;
    private CardDirectionPreference _selectedCardDirection = CardDirectionPreference.Both;
    private LearningMode _selectedLearningMode = LearningModePolicy.DefaultMode;
    private string? _languageConfirmation;
    private ThemePreference? _appearanceConfirmation;
    private int? _preparationLimitConfirmation;
    private bool _languageChangeFailed;
    private bool _appearanceChangeFailed;
    private bool _preparationLimitChangeFailed;
    private bool _cardDirectionSaved;
    private bool _learningModeSaved;
    private bool _onlineConsentRevoked;
    private bool _onlineConsentActivated;
    private bool _enhancedTermRecognitionEnabled;
    private bool _enhancedTermRecognitionSaved;
    private string _selectedLearningTimezoneValue = SystemLearningTimezoneValue;
    private bool _learningTimezoneSaved;
    private string _selectedLearningDayCutoffText =
        LearningDayCutoffFormatter.ToWallClockText(LearningDayConfiguration.DefaultCutoffMinutes);
    private bool _learningDayCutoffSaved;
    private bool _showRestoreDefaultsConfirmation;
    private bool _revealRestoreDefaultsConfirmation;
    private bool _returnFocusToRestoreDefaultsButton;
    private bool _restoreDefaultsSucceeded;
    private bool _restoreDefaultsFailed;
    private ElementReference _restoreDefaultsButton;
    private ElementReference _cancelRestoreDefaultsButton;
    private bool _isPortableDataOperation;
    private bool _portableDataOperationFailed;
    private string? _portableDataMessageKey;
    private IPortableArchiveSelection? _portableImportSelection;
    private PortableImportPreview? _portableImportPreview;
    private PortableImportSummary? _portableImportResultSummary;
    private bool _revealImportPreview;
    private bool _returnFocusToImportButton;
    private ElementReference _dataImportButton;
    private ElementReference _importPreviewElement;
    private ElementReference _cancelImportPreviewButton;
    private bool _hasActiveReview;
    private bool _isChangingLanguage;
    private bool _showResetConfirmation;
    private bool _isResetting;
    private bool _resetSucceeded;
    private bool _resetFailed;
    private bool _isChangingDiagnostics;
    private bool _diagnosticActionFailed;
    private string? _diagnosticMessageKey;
    private bool _revealResetConfirmation;
    private bool _returnFocusToResetButton;
    private bool _isLaunchingBugReport;
    private bool _bugReportFailed;
    private bool _isCopyingBugReportAddress;
    private bool _bugReportAddressCopied;
    private bool _bugReportAddressCopyFailed;
    private ElementReference _resetButton;
    private ElementReference _resetConfirmation;
    private ElementReference _cancelResetButton;

    protected override async Task OnInitializedAsync()
    {
        SyncSettingsStateFromServices();
        _languageConfirmation = SettingsFeedback.ConsumePendingLanguageConfirmation();
        _hasActiveReview = await TextReviewService.GetActiveReviewAsync() is not null;
    }

    /// <summary>
    /// Refreshes every locally mirrored control value from the settings services. Defaults always
    /// originate from the repository policies/services, never from literals in this component.
    /// </summary>
    private void SyncSettingsStateFromServices()
    {
        _selectedLanguagePreference = CurrentLanguagePreferenceValue;
        _selectedTheme = ThemeService.Preference;
        _selectedPreparationLimit = AppSettings.PreparationLimit;
        _selectedCardDirection = AppSettings.CardDirection;
        _selectedLearningMode = AppSettings.LearningMode;
        _enhancedTermRecognitionEnabled = AppSettings.EnhancedTermRecognitionEnabled;
        _selectedLearningTimezoneValue = CurrentLearningTimezoneValue;
        _selectedLearningDayCutoffText =
            LearningDayCutoffFormatter.ToWallClockText(AppSettings.LearningDayCutoffMinutes);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_revealResetConfirmation)
        {
            _revealResetConfirmation = false;
            await JsRuntime.InvokeVoidAsync("knownFirst.revealElement", _resetConfirmation);
            await _cancelResetButton.FocusAsync(preventScroll: true);
        }
        else if (_returnFocusToResetButton)
        {
            _returnFocusToResetButton = false;
            await _resetButton.FocusAsync();
        }
        else if (_revealImportPreview)
        {
            _revealImportPreview = false;
            await JsRuntime.InvokeVoidAsync("knownFirst.revealElement", _importPreviewElement);
            await _cancelImportPreviewButton.FocusAsync(preventScroll: true);
        }
        else if (_returnFocusToImportButton)
        {
            _returnFocusToImportButton = false;
            await _dataImportButton.FocusAsync();
        }
        else if (_revealRestoreDefaultsConfirmation)
        {
            _revealRestoreDefaultsConfirmation = false;
            await _cancelRestoreDefaultsButton.FocusAsync(preventScroll: true);
        }
        else if (_returnFocusToRestoreDefaultsButton)
        {
            _returnFocusToRestoreDefaultsButton = false;
            await _restoreDefaultsButton.FocusAsync();
        }
    }

    private string CurrentLanguagePreferenceValue =>
        LanguageSelection.IsSystemPreferenceActive
            ? LanguageSelectionService.SystemPreferenceCode
            : LanguageSelection.CurrentUiLanguage;

    private static string GetLanguageConfirmationKey(string languageCode) => languageCode switch
    {
        LanguageSelectionService.GermanLanguageCode => "Settings_LanguageChangedToGerman",
        LanguageSelectionService.RussianLanguageCode => "Settings_LanguageChangedToRussian",
        LanguageSelectionService.SystemPreferenceCode => "Settings_LanguageChangedToSystem",
        _ => "Settings_LanguageChangedToEnglish"
    };

    private bool IsThemeSelected(ThemePreference preference) => _selectedTheme == preference;

    private string GetAppearanceDisplayName(ThemePreference preference) => preference switch
    {
        ThemePreference.Light => Localizer["Settings_AppearanceLight"],
        ThemePreference.Dark => Localizer["Settings_AppearanceDark"],
        _ => Localizer["Settings_AppearanceSystem"]
    };

    private void HandleUiLanguagePreferenceChanged()
    {
        if (_isChangingLanguage || string.Equals(_selectedLanguagePreference, CurrentLanguagePreferenceValue, StringComparison.OrdinalIgnoreCase))
        {
            _selectedLanguagePreference = CurrentLanguagePreferenceValue;
            return;
        }

        _isChangingLanguage = true;
        _languageConfirmation = null;
        _languageChangeFailed = false;
        SettingsFeedback.SetPendingLanguageConfirmation(_selectedLanguagePreference);

        try
        {
            LanguageSelection.SetUiLanguage(_selectedLanguagePreference);
            _selectedLanguagePreference = CurrentLanguagePreferenceValue;
        }
        catch (Exception exception)
        {
            SettingsFeedback.ClearPendingLanguageConfirmation();
            Logger.LogError(exception, "The UI language could not be changed.");
            _languageChangeFailed = true;
            _selectedLanguagePreference = CurrentLanguagePreferenceValue;
        }
        finally
        {
            _isChangingLanguage = false;
        }
    }

    private void SelectTheme(ThemePreference preference)
    {
        if (IsThemeSelected(preference))
        {
            return;
        }

        _appearanceConfirmation = null;
        _appearanceChangeFailed = false;

        try
        {
            if (ThemeService.SetPreference(preference))
            {
                _selectedTheme = ThemeService.Preference;
                _appearanceConfirmation = _selectedTheme;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The appearance preference could not be changed.");
            _appearanceChangeFailed = true;
        }
    }

    private void SavePreparationLimit()
    {
        _preparationLimitConfirmation = null;
        _preparationLimitChangeFailed = false;

        try
        {
            AppSettings.SetPreparationLimit(_selectedPreparationLimit);
            _selectedPreparationLimit = AppSettings.PreparationLimit;
            _preparationLimitConfirmation = _selectedPreparationLimit;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The preparation limit could not be saved.");
            _preparationLimitChangeFailed = true;
        }
    }

    private string CurrentLearningTimezoneValue =>
        AppSettings.LearningTimezoneMode == LearningTimezoneMode.Explicit
        && LearningTimezoneCatalog.ContainsTimezoneId(AppSettings.ExplicitLearningTimezoneId)
            ? AppSettings.ExplicitLearningTimezoneId!
            : SystemLearningTimezoneValue;

    /// <summary>
    /// The offset shown next to the control is always recomputed from <see cref="TimeZoneInfo"/>
    /// for the current instant, so it follows daylight saving time instead of a stored offset.
    /// </summary>
    private string EffectiveLearningTimezoneOffsetLabel =>
        LearningTimezoneLabelFormatter.FormatUtcOffset(
            LearningTimezoneResolver.ResolveEffectiveTimeZone(
                AppSettings.LearningTimezoneMode,
                AppSettings.ExplicitLearningTimezoneId),
            DateTime.UtcNow);

    private string GetLearningTimezoneOptionLabel(LearningTimezoneOption option)
    {
        string cityName = Localizer[option.CityResourceKey];

        try
        {
            var timeZone = TimeZoneInfo.FindSystemTimeZoneById(option.TimezoneId);
            return LearningTimezoneLabelFormatter.FormatOptionLabel(timeZone, DateTime.UtcNow, cityName);
        }
        catch (TimeZoneNotFoundException)
        {
            return cityName;
        }
        catch (InvalidTimeZoneException)
        {
            return cityName;
        }
    }

    private void SelectLearningTimezone()
    {
        _learningTimezoneSaved = false;

        try
        {
            if (string.Equals(_selectedLearningTimezoneValue, SystemLearningTimezoneValue, StringComparison.Ordinal))
            {
                AppSettings.SetLearningTimezoneMode(LearningTimezoneMode.System);
                AppSettings.SetExplicitLearningTimezoneId(null);
            }
            else if (LearningTimezoneCatalog.ContainsTimezoneId(_selectedLearningTimezoneValue))
            {
                AppSettings.SetExplicitLearningTimezoneId(_selectedLearningTimezoneValue);
                AppSettings.SetLearningTimezoneMode(LearningTimezoneMode.Explicit);
            }

            _learningTimezoneSaved = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The learning time zone could not be saved.");
        }
        finally
        {
            _selectedLearningTimezoneValue = CurrentLearningTimezoneValue;
        }
    }

    private void SaveLearningDayCutoff(ChangeEventArgs eventArgs)
    {
        _learningDayCutoffSaved = false;

        try
        {
            AppSettings.SetLearningDayCutoffMinutes(
                LearningDayCutoffFormatter.ParseWallClockText(eventArgs.Value?.ToString()));
            _learningDayCutoffSaved = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The learning day cutoff could not be saved.");
        }
        finally
        {
            _selectedLearningDayCutoffText =
                LearningDayCutoffFormatter.ToWallClockText(AppSettings.LearningDayCutoffMinutes);
        }
    }

    private void ShowRestoreDefaultsConfirmation()
    {
        _restoreDefaultsSucceeded = false;
        _restoreDefaultsFailed = false;
        _showRestoreDefaultsConfirmation = true;
        _revealRestoreDefaultsConfirmation = true;
    }

    private void CancelRestoreDefaults()
    {
        _showRestoreDefaultsConfirmation = false;
        _returnFocusToRestoreDefaultsButton = true;
    }

    private void HandleRestoreDefaultsDialogKeyDown(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Escape")
        {
            CancelRestoreDefaults();
        }
    }

    /// <summary>
    /// Non-destructive restore of settings, theme, and language defaults. It never resets the
    /// database, never clears the whole preference store, and never removes user learning content.
    /// The user's current online dictionary lookup consent is left exactly as it is; only the
    /// destructive full application reset revokes it.
    /// </summary>
    private void RestoreDefaults()
    {
        _restoreDefaultsSucceeded = false;
        _restoreDefaultsFailed = false;

        try
        {
            SettingsDefaults.RestoreDefaults();
            SyncSettingsStateFromServices();
            _showRestoreDefaultsConfirmation = false;
            _restoreDefaultsSucceeded = true;
            _returnFocusToRestoreDefaultsButton = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The default settings could not be restored.");
            _restoreDefaultsFailed = true;
        }
    }

    private void SelectCardDirection(CardDirectionPreference preference)
    {
        if (_selectedCardDirection == preference)
        {
            return;
        }

        AppSettings.SetCardDirection(preference);
        _selectedCardDirection = AppSettings.CardDirection;
        _cardDirectionSaved = true;
    }

    private void SelectLearningMode(LearningMode mode)
    {
        if (_selectedLearningMode == mode)
        {
            return;
        }

        AppSettings.SetLearningMode(mode);
        _selectedLearningMode = AppSettings.LearningMode;
        _learningModeSaved = true;
    }

    private void SetEnhancedTermRecognition(bool enabled)
    {
        if (_enhancedTermRecognitionEnabled == enabled)
        {
            return;
        }

        AppSettings.SetEnhancedTermRecognitionEnabled(enabled);
        _enhancedTermRecognitionEnabled = AppSettings.EnhancedTermRecognitionEnabled;
        _enhancedTermRecognitionSaved = true;
    }

    private void RevokeOnlineConsent()
    {
        AppSettings.RevokeOnlineLookupConsent();
        _onlineConsentRevoked = true;
        _onlineConsentActivated = false;
    }

    private void ActivateOnlineConsent()
    {
        AppSettings.GrantOnlineLookupConsent();
        _onlineConsentActivated = true;
        _onlineConsentRevoked = false;
    }

    private async Task ExportPortableDataAsync()
    {
        _isPortableDataOperation = true;
        _portableDataOperationFailed = false;
        _portableDataMessageKey = null;
        try
        {
            var fileName = $"KnownFirst-Data-{DateTime.UtcNow:yyyy-MM-dd}.kfarchive";
            var status = await PortableArchiveFiles.ExportAsync(
                fileName,
                BackupService.CreatePortableArchiveAsync,
                CancellationToken.None);
            _portableDataMessageKey = status == PortableArchiveSaveStatus.Saved
                ? "Settings_DataExportSuccess"
                : "Settings_DataExportCancelled";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The portable data export failed.");
            _portableDataOperationFailed = true;
            _portableDataMessageKey = "Settings_DataExportFailure";
        }
        finally
        {
            _isPortableDataOperation = false;
        }
    }

    private async Task ChoosePortableImportAsync()
    {
        _isPortableDataOperation = true;
        _portableDataOperationFailed = false;
        _portableDataMessageKey = null;
        _portableImportResultSummary = null;
        _portableImportPreview = null;
        await DisposePortableImportSelectionAsync();

        try
        {
            _portableImportSelection =
                await PortableArchiveFiles.PickImportAsync(CancellationToken.None);
            if (_portableImportSelection is null)
            {
                return;
            }

            PortableImportPreview preview;
            await using (var stream = await _portableImportSelection.OpenReadAsync(CancellationToken.None))
            {
                preview = await BackupService.PreviewPortableImportAsync(stream, CancellationToken.None);
            }

            if (IsPreviewPanelDisposition(preview.Disposition))
            {
                _portableImportPreview = preview;
                _revealImportPreview = true;
            }
            else
            {
                (_portableDataMessageKey, _portableDataOperationFailed) = MapPreviewBlockedMessage(preview);
                await DisposePortableImportSelectionAsync();
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "The selected portable data archive could not be previewed.");
            _portableDataOperationFailed = true;
            _portableDataMessageKey = "Settings_DataImportValidationFailure";
            await DisposePortableImportSelectionAsync();
        }
        finally
        {
            _isPortableDataOperation = false;
        }
    }

    private async Task ConfirmPortableImportAsync()
    {
        if (_portableImportSelection is null || _portableImportPreview is not { CanConfirm: true })
        {
            return;
        }

        _isPortableDataOperation = true;
        _portableDataOperationFailed = false;
        _portableDataMessageKey = null;
        _portableImportResultSummary = null;
        try
        {
            await using var stream =
                await _portableImportSelection.OpenReadAsync(CancellationToken.None);
            var result = await BackupService.ImportPortableArchiveAsync(
                stream,
                CancellationToken.None);
            (_portableDataMessageKey, _portableDataOperationFailed) = MapImportResultMessage(result);
            _portableImportResultSummary = result.Summary;

            if (result.Summary?.Disposition is
                PortableImportDisposition.RestoredIntoEmpty or PortableImportDisposition.MergeApplied)
            {
                WorkflowChangeNotifier.NotifyChanged();
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The portable data import failed.");
            _portableDataOperationFailed = true;
            _portableDataMessageKey = "Settings_DataImportFailure";
        }
        finally
        {
            _portableImportPreview = null;
            await DisposePortableImportSelectionAsync();
            _isPortableDataOperation = false;
            _returnFocusToImportButton = true;
        }
    }

    private async Task CancelPortableImportAsync()
    {
        if (_isPortableDataOperation)
        {
            return;
        }

        _portableImportPreview = null;
        await DisposePortableImportSelectionAsync();
        _returnFocusToImportButton = true;
    }

    private void HandleImportPreviewKeyDown(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Escape")
        {
            _ = CancelPortableImportAsync();
        }
    }

    private static bool IsPreviewPanelDisposition(PortableImportPreviewDisposition disposition) =>
        disposition is PortableImportPreviewDisposition.RestoreIntoEmpty
            or PortableImportPreviewDisposition.MergeChanges
            or PortableImportPreviewDisposition.MergeNoChange;

    private static string GetImportPreviewTitleKey(PortableImportPreviewDisposition disposition) => disposition switch
    {
        PortableImportPreviewDisposition.RestoreIntoEmpty => "Settings_DataImportPreviewRestoreTitle",
        PortableImportPreviewDisposition.MergeChanges => "Settings_DataImportPreviewMergeTitle",
        _ => "Settings_DataImportPreviewNoChangeTitle"
    };

    private static string GetImportPreviewDescriptionKey(PortableImportPreviewDisposition disposition) => disposition switch
    {
        PortableImportPreviewDisposition.RestoreIntoEmpty => "Settings_DataImportPreviewRestoreDescription",
        PortableImportPreviewDisposition.MergeChanges => "Settings_DataImportPreviewMergeDescription",
        _ => "Settings_DataImportPreviewNoChangeDescription"
    };

    private static string GetImportConfirmActionKey(PortableImportPreviewDisposition disposition) =>
        disposition == PortableImportPreviewDisposition.RestoreIntoEmpty
            ? "Settings_DataImportConfirmRestoreAction"
            : "Settings_DataImportConfirmMergeAction";

    private static (string MessageKey, bool IsError) MapPreviewBlockedMessage(PortableImportPreview preview) =>
        preview.Disposition switch
        {
            PortableImportPreviewDisposition.ValidationFailed => ("Settings_DataImportValidationFailure", true),
            PortableImportPreviewDisposition.Cancelled => ("Settings_DataImportFailureCancelled", true),
            PortableImportPreviewDisposition.Blocked when preview.ErrorCode == BackupErrorCodes.TargetNotEmpty =>
                ("Settings_DataImportTargetNotEmpty", true),
            PortableImportPreviewDisposition.Blocked when preview.ErrorCode == BackupErrorCodes.ActiveWorkflowUnsupported =>
                ("Settings_DataImportFailureActiveWorkflow", true),
            PortableImportPreviewDisposition.Blocked => ("Settings_DataImportPreviewBlockedGeneric", true),
            _ => ("Settings_DataImportFailure", true)
        };

    private static (string MessageKey, bool IsError) MapImportResultMessage(PortableImportResult result) => result.Status switch
    {
        PortableImportStatus.Success => result.Summary!.Disposition switch
        {
            PortableImportDisposition.RestoredIntoEmpty => ("Settings_DataImportResultRestored", false),
            PortableImportDisposition.MergeApplied => ("Settings_DataImportResultMergeApplied", false),
            PortableImportDisposition.MergeNoChange => ("Settings_DataImportResultMergeNoChange", false),
            _ => ("Settings_DataImportSuccess", false)
        },
        PortableImportStatus.TargetNotEmpty => ("Settings_DataImportTargetNotEmpty", true),
        PortableImportStatus.ValidationFailed => ("Settings_DataImportValidationFailure", true),
        PortableImportStatus.Cancelled => ("Settings_DataImportFailureCancelled", true),
        PortableImportStatus.Failed => (MapFailedErrorCodeMessageKey(result.ErrorCode), true),
        _ => ("Settings_DataImportFailure", true)
    };

    private static string MapFailedErrorCodeMessageKey(string? errorCode) => errorCode switch
    {
        BackupErrorCodes.ActiveWorkflowUnsupported => "Settings_DataImportFailureActiveWorkflow",
        KnownFirst.Services.DataSafety.Merge.MergeWriterErrorCodes.StalePlan => "Settings_DataImportFailureStalePlan",
        BackupErrorCodes.SafetyBackupFailed or BackupErrorCodes.InsufficientSpace or BackupErrorCodes.IoFailure =>
            "Settings_DataImportFailureSafetyCopy",
        _ => "Settings_DataImportFailure"
    };

    private async Task DisposePortableImportSelectionAsync()
    {
        if (_portableImportSelection is null)
        {
            return;
        }

        await _portableImportSelection.DisposeAsync();
        _portableImportSelection = null;
    }

    async ValueTask IAsyncDisposable.DisposeAsync() =>
        await DisposePortableImportSelectionAsync();

    private async Task CopyLexicalDiagnosticReportAsync()
    {
        await RunDiagnosticActionAsync(async () =>
        {
            await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(
                LexicalDiagnosticLog.ReadReport());
            _diagnosticMessageKey = "Diagnostics_DiagnosticReportCopied";
        });
    }

    private async Task ExportLexicalDiagnosticLogAsync()
    {
        await RunDiagnosticActionAsync(async () =>
        {
            await Microsoft.Maui.ApplicationModel.DataTransfer.Share.Default.RequestAsync(
                new Microsoft.Maui.ApplicationModel.DataTransfer.ShareFileRequest
                {
                    Title = Localizer["Diagnostics_ExportDiagnosticLog"],
                    File = new Microsoft.Maui.ApplicationModel.DataTransfer.ShareFile(
                        LexicalDiagnosticLog.ExportPath)
                });
            _diagnosticMessageKey = "Diagnostics_DiagnosticLogExported";
        });
    }

    private Task ClearLexicalDiagnosticLogAsync() => RunDiagnosticActionAsync(() =>
    {
        LexicalDiagnosticLog.Clear();
        _diagnosticMessageKey = "Diagnostics_DiagnosticLogCleared";
        return Task.CompletedTask;
    });

    private async Task RunDiagnosticActionAsync(Func<Task> action)
    {
        _isChangingDiagnostics = true;
        _diagnosticActionFailed = false;
        _diagnosticMessageKey = null;
        try
        {
            await action();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The lexical diagnostic log action failed.");
            _diagnosticActionFailed = true;
            _diagnosticMessageKey = "Diagnostics_DiagnosticLogActionError";
        }
        finally
        {
            _isChangingDiagnostics = false;
        }
    }

    private async Task ReportBugAsync()
    {
        if (_isLaunchingBugReport)
        {
            return;
        }

        _isLaunchingBugReport = true;
        _bugReportFailed = false;
        _bugReportAddressCopied = false;
        _bugReportAddressCopyFailed = false;
        try
        {
            var launched = await BugReportLauncher.LaunchBugReportAsync();
            if (!launched)
            {
                _bugReportFailed = true;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The bug report action failed.");
            _bugReportFailed = true;
        }
        finally
        {
            _isLaunchingBugReport = false;
        }
    }

    private async Task CopyBugReportAddressAsync()
    {
        if (_isCopyingBugReportAddress)
        {
            return;
        }

        _isCopyingBugReportAddress = true;
        _bugReportAddressCopied = false;
        _bugReportAddressCopyFailed = false;
        try
        {
            await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(
                BugReportLauncher.RecipientEmail);
            _bugReportAddressCopied = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The bug report address could not be copied to the clipboard.");
            _bugReportAddressCopyFailed = true;
        }
        finally
        {
            _isCopyingBugReportAddress = false;
        }
    }

    private static bool DiagnosticsEnabled
    {
        get
        {
#if DEBUG || KNOWNFIRST_DIAGNOSTICS
            return true;
#else
            return false;
#endif
        }
    }

    private void ShowResetConfirmation()
    {
        _resetSucceeded = false;
        _resetFailed = false;
        _showResetConfirmation = true;
        _revealResetConfirmation = true;
    }

    private void CancelReset()
    {
        if (_isResetting)
        {
            return;
        }

        _showResetConfirmation = false;
        _resetFailed = false;
        _returnFocusToResetButton = true;
    }

    private void HandleResetDialogKeyDown(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Escape")
        {
            CancelReset();
        }
    }

    private async Task ResetDataAsync()
    {
        _isResetting = true;
        _resetSucceeded = false;
        _resetFailed = false;

        try
        {
            await Database.ResetAsync();
            Preferences.Clear();
            SettingsDefaults.RestoreDefaultsForFullReset();
            SyncSettingsStateFromServices();
            _showResetConfirmation = false;
            _resetSucceeded = true;
            _returnFocusToResetButton = true;
            WorkflowChangeNotifier.NotifyChanged();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Local application data could not be reset.");
            _resetFailed = true;
        }
        finally
        {
            _isResetting = false;
        }
    }
}
