@namespace KnownFirst.Components.Onboarding.Steps
@using KnownFirst.Core.Settings
@inject IStringLocalizer<SharedResource> Localizer

<div class="onboarding-step onboarding-practice-step">
    <h1 class="onboarding-title" id="onboarding-practice-title">@Localizer["Onboarding_PracticeTitle"]</h1>
    <p class="onboarding-concept">@Localizer["Onboarding_PracticeDescription"]</p>

    <section class="onboarding-card" aria-labelledby="onboarding-card-direction-title">
        <h2 id="onboarding-card-direction-title" class="onboarding-section-title">@Localizer["Settings_CardDirection"]</h2>
        <p id="onboarding-card-direction-help" class="setting-help">@Localizer["Settings_CardDirectionHelp"]</p>
        <div class="choice-grid choice-grid-three" role="group" aria-labelledby="onboarding-card-direction-title" aria-describedby="onboarding-card-direction-help">
            <button type="button"
                    id="onboarding-card-direction-both"
                    class="choice-button @(CardDirection == CardDirectionPreference.Both ? "active" : null)"
                    aria-pressed="@(CardDirection == CardDirectionPreference.Both)"
                    @onclick="() => SelectCardDirection(CardDirectionPreference.Both)">
                @Localizer["Settings_CardDirectionBoth"]
            </button>
            <button type="button"
                    id="onboarding-card-direction-term-to-meaning"
                    class="choice-button @(CardDirection == CardDirectionPreference.TermToMeaning ? "active" : null)"
                    aria-pressed="@(CardDirection == CardDirectionPreference.TermToMeaning)"
                    @onclick="() => SelectCardDirection(CardDirectionPreference.TermToMeaning)">
                @Localizer["Settings_CardDirectionTermToMeaning"]
            </button>
            <button type="button"
                    id="onboarding-card-direction-meaning-to-term"
                    class="choice-button @(CardDirection == CardDirectionPreference.MeaningToTerm ? "active" : null)"
                    aria-pressed="@(CardDirection == CardDirectionPreference.MeaningToTerm)"
                    @onclick="() => SelectCardDirection(CardDirectionPreference.MeaningToTerm)">
                @Localizer["Settings_CardDirectionMeaningToTerm"]
            </button>
        </div>
    </section>

    <section class="onboarding-card" aria-labelledby="onboarding-learning-mode-title">
        <h2 id="onboarding-learning-mode-title" class="onboarding-section-title">@Localizer["Settings_LearningMode"]</h2>
        <p id="onboarding-learning-mode-help" class="setting-help">@Localizer["Settings_LearningModeHelp"]</p>
        <div class="choice-grid choice-grid-three" role="group" aria-labelledby="onboarding-learning-mode-title" aria-describedby="onboarding-learning-mode-help">
            <button type="button"
                    id="onboarding-learning-mode-automatic"
                    class="choice-button @(LearningMode == LearningMode.Automatic ? "active" : null)"
                    aria-pressed="@(LearningMode == LearningMode.Automatic)"
                    @onclick="() => SelectLearningMode(LearningMode.Automatic)">
                @Localizer["Settings_LearningModeAutomatic"]
            </button>
            <button type="button"
                    id="onboarding-learning-mode-reading"
                    class="choice-button @(LearningMode == LearningMode.Reading ? "active" : null)"
                    aria-pressed="@(LearningMode == LearningMode.Reading)"
                    @onclick="() => SelectLearningMode(LearningMode.Reading)">
                @Localizer["Settings_LearningModeReading"]
            </button>
            <button type="button"
                    id="onboarding-learning-mode-typing"
                    class="choice-button @(LearningMode == LearningMode.Typing ? "active" : null)"
                    aria-pressed="@(LearningMode == LearningMode.Typing)"
                    @onclick="() => SelectLearningMode(LearningMode.Typing)">
                @Localizer["Settings_LearningModeTyping"]
            </button>
        </div>
    </section>

    <div class="onboarding-actions">
        <button type="button"
                id="onboarding-practice-continue-button"
                class="button button-primary onboarding-continue-button"
                @onclick="OnContinue">
            @Localizer["Common_Continue"]
        </button>
        <button type="button"
                id="onboarding-practice-back-button"
                class="button button-secondary onboarding-back-button"
                @onclick="OnBack">
            @Localizer["Common_Back"]
        </button>
    </div>
</div>

@code {
    [Parameter] public CardDirectionPreference CardDirection { get; set; }
    [Parameter] public LearningMode LearningMode { get; set; }
    [Parameter] public EventCallback<CardDirectionPreference> OnCardDirectionChanged { get; set; }
    [Parameter] public EventCallback<LearningMode> OnLearningModeChanged { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private async Task SelectCardDirection(CardDirectionPreference preference)
    {
        if (OnCardDirectionChanged.HasDelegate)
        {
            await OnCardDirectionChanged.InvokeAsync(preference);
        }
    }

    private async Task SelectLearningMode(LearningMode mode)
    {
        if (OnLearningModeChanged.HasDelegate)
        {
            await OnLearningModeChanged.InvokeAsync(mode);
        }
    }
}
