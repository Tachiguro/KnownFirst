@namespace KnownFirst.Components.Onboarding.Steps
@using KnownFirst.Services
@inject IAppSettingsService AppSettings
@inject IStringLocalizer<SharedResource> Localizer

<div class="onboarding-step onboarding-online-lookup-step">
    <h1 class="onboarding-title" id="onboarding-online-lookup-title">@Localizer["Onboarding_OnlineLookupTitle"]</h1>
    <p class="onboarding-concept">@Localizer["Onboarding_OnlineLookupDescription"]</p>

    <section class="onboarding-card" aria-labelledby="onboarding-online-lookup-title">
        <p class="setting-help">
            @Localizer[AppSettings.HasOnlineLookupConsent ? "Settings_OnlineConsentGranted" : "Settings_OnlineConsentNotGranted"]
        </p>
        @if (AppSettings.HasOnlineLookupConsent)
        {
            @if (!_showOnlineConsentRevokeConfirmation)
            {
                <button type="button"
                        id="onboarding-online-consent-revoke-button"
                        class="button button-danger"
                        @onclick="ShowOnlineConsentRevokeConfirmation">
                    @Localizer["Settings_RevokeOnlineConsent"]
                </button>
            }
            else
            {
                <div id="onboarding-online-consent-revoke-confirmation"
                     class="destructive-confirmation"
                     role="alertdialog"
                     aria-labelledby="onboarding-online-consent-revoke-confirmation-message">
                    <p id="onboarding-online-consent-revoke-confirmation-message">
                        @Localizer["Settings_RevokeOnlineConsentConfirmMessage"]
                    </p>
                    <div class="button-row">
                        <button type="button"
                                id="onboarding-online-consent-revoke-cancel-button"
                                class="button button-secondary"
                                @onclick="CancelOnlineConsentRevocation">
                            @Localizer["Common_Cancel"]
                        </button>
                        <button type="button"
                                id="onboarding-online-consent-revoke-confirm-button"
                                class="button button-danger"
                                data-destructive-confirm
                                @onclick="ConfirmOnlineConsentRevocation">
                            @Localizer["Settings_RevokeOnlineConsent"]
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <h2 class="onboarding-section-title">@Localizer["Prepare_OnlineDisclosureTitle"]</h2>
            <p class="setting-help">@Localizer["Prepare_OnlineDisclosure"]</p>
            <button type="button"
                    id="onboarding-online-consent-activate-button"
                    class="button button-primary"
                    @onclick="ActivateOnlineConsent">
                @Localizer["Settings_ActivateOnlineConsent"]
            </button>
        }
    </section>

    <div class="onboarding-actions">
        <button type="button"
                id="onboarding-online-lookup-continue-button"
                class="button button-primary onboarding-continue-button"
                @onclick="OnContinue">
            @Localizer["Common_Continue"]
        </button>
        <button type="button"
                id="onboarding-online-lookup-back-button"
                class="button button-secondary onboarding-back-button"
                @onclick="OnBack">
            @Localizer["Common_Back"]
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnContinue { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private bool _showOnlineConsentRevokeConfirmation;

    private void ActivateOnlineConsent()
    {
        AppSettings.GrantOnlineLookupConsent();
        _showOnlineConsentRevokeConfirmation = false;
    }

    private void ShowOnlineConsentRevokeConfirmation()
    {
        _showOnlineConsentRevokeConfirmation = true;
    }

    private void CancelOnlineConsentRevocation()
    {
        _showOnlineConsentRevokeConfirmation = false;
    }

    private void ConfirmOnlineConsentRevocation()
    {
        AppSettings.RevokeOnlineLookupConsent();
        _showOnlineConsentRevokeConfirmation = false;
    }
}
