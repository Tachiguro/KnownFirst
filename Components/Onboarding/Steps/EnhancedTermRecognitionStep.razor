@namespace KnownFirst.Components.Onboarding.Steps
@inject IStringLocalizer<SharedResource> Localizer

<div class="onboarding-step onboarding-etr-step">
    <h1 class="onboarding-title" id="onboarding-etr-title">@Localizer["Onboarding_EnhancedTermRecognitionTitle"]</h1>
    <p class="onboarding-concept">@Localizer["Onboarding_EnhancedTermRecognitionDescription"]</p>

    <section class="onboarding-card" aria-labelledby="onboarding-etr-title">
        <div class="choice-grid choice-grid-two" role="group" aria-labelledby="onboarding-etr-title">
            <button type="button"
                    id="onboarding-etr-on-button"
                    class="choice-button @(EnhancedTermRecognitionEnabled ? "active" : null)"
                    aria-pressed="@EnhancedTermRecognitionEnabled"
                    @onclick="() => SetEtr(true)">
                @Localizer["Settings_EnhancedTermRecognitionOn"]
            </button>
            <button type="button"
                    id="onboarding-etr-off-button"
                    class="choice-button @(!EnhancedTermRecognitionEnabled ? "active" : null)"
                    aria-pressed="@(!EnhancedTermRecognitionEnabled)"
                    @onclick="() => SetEtr(false)">
                @Localizer["Settings_EnhancedTermRecognitionOff"]
            </button>
        </div>
    </section>

    <div class="onboarding-actions">
        <button type="button"
                id="onboarding-etr-continue-button"
                class="button button-primary onboarding-continue-button"
                @onclick="OnContinue">
            @Localizer["Common_Continue"]
        </button>
        <button type="button"
                id="onboarding-etr-back-button"
                class="button button-secondary onboarding-back-button"
                @onclick="OnBack">
            @Localizer["Common_Back"]
        </button>
    </div>
</div>

@code {
    [Parameter] public bool EnhancedTermRecognitionEnabled { get; set; }
    [Parameter] public EventCallback<bool> OnEnhancedTermRecognitionChanged { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private async Task SetEtr(bool enabled)
    {
        if (OnEnhancedTermRecognitionChanged.HasDelegate)
        {
            await OnEnhancedTermRecognitionChanged.InvokeAsync(enabled);
        }
    }
}
