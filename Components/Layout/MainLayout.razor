@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject INavigationHistoryService NavigationHistory
@inject ILogger<MainLayout> Logger

<KnownFirst.Components.Shared.GuiTestProfileIndicator />
<div class="page @(_isMenuOpen ? "menu-open" : null)" @onkeydown="HandleKeyDown">
    <header class="mobile-header">
        <button type="button"
                class="menu-toggle"
                aria-controls="primary-navigation"
                aria-expanded="@_isMenuOpen"
                aria-label="@MenuButtonLabel"
                title="@MenuButtonLabel"
                @onclick="ToggleMenu">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </button>
        @if (!string.IsNullOrEmpty(CurrentPageTitle))
        {
            <span class="mobile-page-title">@CurrentPageTitle</span>
        }
    </header>

    @if (_isMenuOpen)
    {
        <button type="button"
                class="navigation-backdrop"
                aria-label="@MenuButtonLabel"
                @onclick="CloseMenu"></button>
    }

    <aside id="primary-navigation" class="sidebar @(_isMenuOpen ? "open" : null)">
        <NavMenu OnNavigate="CloseMenu" />
    </aside>

    <main inert="@(_isMenuOpen ? "inert" : null)">
        <article class="content" tabindex="0">
            @Body
        </article>
    </main>
</div>

<WhatsNewModal />

@code {
    private bool _isMenuOpen;
    private IDisposable? _menuBackRegistration;
    private string _currentRoute = string.Empty;

    private string MenuButtonLabel => Localizer[_isMenuOpen
        ? "Navigation_CloseMenu"
        : "Navigation_OpenMenu"];

    private string CurrentPageTitle => _currentRoute.ToLowerInvariant() switch
    {
        "" => string.Empty,
        "import-text" => Localizer["Navigation_ImportText"],
        "review-words" => Localizer["Navigation_ReviewWords"],
        "prepare-words" => Localizer["Navigation_PrepareWords"],
        "learn" => Localizer["Navigation_Learn"],
        "dictionary" => Localizer["Navigation_Dictionary"],
        "settings" => Localizer["Navigation_Settings"],
        "release-notes" => Localizer["WhatsNew_Title"],
        "diagnostics" => Localizer["Diagnostics_Title"],
        _ => Localizer["NotFound_Title"]
    };

    protected override void OnInitialized()
    {
        RecordCurrentRoute(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        _menuBackRegistration?.Dispose();
    }

    private void ToggleMenu()
    {
        if (_isMenuOpen)
        {
            CloseMenu();
            return;
        }

        _isMenuOpen = true;
        _menuBackRegistration = NavigationHistory.RegisterDismissibleOverlay(
            DismissMenuFromBackNavigation);
    }

    private void CloseMenu()
    {
        _menuBackRegistration?.Dispose();
        _menuBackRegistration = null;
        _isMenuOpen = false;
    }

    private void HandleKeyDown(KeyboardEventArgs eventArgs)
    {
        if (_isMenuOpen
            && (string.Equals(eventArgs.Key, "Escape", StringComparison.Ordinal)
                || string.Equals(eventArgs.Key, "Esc", StringComparison.Ordinal)))
        {
            CloseMenu();
        }
    }

    private void DismissMenuFromBackNavigation() => _ = InvokeAsync(() =>
    {
        CloseMenu();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs eventArgs)
    {
        RecordCurrentRoute(eventArgs.Location);
        CloseMenu();
        _ = InvokeAsync(StateHasChanged);
    }

    private void RecordCurrentRoute(string absoluteUri)
    {
        _currentRoute = NormalizeRoute(Navigation.ToBaseRelativePath(absoluteUri));
        NavigationHistory.RecordNavigation(_currentRoute);
        Logger.LogDebug("Navigation completed. Route = {Route}", _currentRoute);
    }

    private static string NormalizeRoute(string relativeRoute)
    {
        var suffixIndex = relativeRoute.IndexOfAny(['?', '#']);
        var route = suffixIndex >= 0 ? relativeRoute[..suffixIndex] : relativeRoute;
        return route.Trim('/');
    }
}
