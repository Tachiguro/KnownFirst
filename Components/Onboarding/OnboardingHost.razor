@namespace KnownFirst.Components.Onboarding
@implements IDisposable
@using System.Globalization
@using KnownFirst.Components.Onboarding.Steps
@using KnownFirst.Core.Language
@using KnownFirst.Core.Settings
@using KnownFirst.Services
@using KnownFirst.Services.Onboarding
@inject IOnboardingStateStore OnboardingStateStore
@inject IOnboardingProgressStore OnboardingProgressStore
@inject IOnboardingDraftStore OnboardingDraftStore
@inject IOnboardingCompletionService CompletionService
@inject ILanguageSelectionService LanguageSelection
@inject IDeviceCultureProvider DeviceCultureProvider
@inject IThemeService ThemeService
@inject IStringLocalizer<SharedResource> Localizer

<div class="onboarding-host">
    <main class="onboarding-main" tabindex="-1">
        <div class="onboarding-container">
            @switch (_currentStep)
            {
                case OnboardingStep.WelcomeLanguage:
                    <div class="onboarding-step onboarding-welcome-step">
                        <h1 class="onboarding-title" id="onboarding-welcome-title">@Localizer["Onboarding_WelcomeTitle"]</h1>
                        <p class="onboarding-concept">@Localizer["Onboarding_WelcomeConcept"]</p>

                        <section class="onboarding-language-section" aria-labelledby="onboarding-language-title">
                            <h2 id="onboarding-language-title" class="onboarding-section-title">
                                <label for="onboarding-ui-language-select">@Localizer["Settings_UILanguage"]</label>
                            </h2>
                            <div class="field-group">
                                <select id="onboarding-ui-language-select"
                                        @bind="_selectedLanguagePreference"
                                        @bind:after="HandleLanguagePreferenceChanged">
                                    @foreach (var option in LanguagePreferencePolicy.UiLanguageOptions)
                                    {
                                        <option value="@option.PreferenceCode">@Localizer[option.LocalizationKey]</option>
                                    }
                                </select>
                            </div>

                            @if (string.Equals(_draft.UiLanguage, LanguagePreferencePolicy.SystemPreferenceCode, StringComparison.OrdinalIgnoreCase))
                            {
                                <div id="onboarding-system-language-status" class="onboarding-system-language-status" role="status" aria-live="polite">
                                    <p class="setting-status">
                                        @Localizer["Onboarding_SystemLanguageDetected", GetDetectedDeviceCultureDisplayName(), DetectedDeviceCultureCode]
                                    </p>
                                    @if (!_deviceLanguageClassification.IsSupported)
                                    {
                                        <p id="onboarding-system-language-fallback" class="setting-feedback setting-feedback-advisory">
                                            @Localizer["Onboarding_SystemLanguageUnsupported"]
                                        </p>
                                    }
                                </div>
                            }
                        </section>

                        <section class="onboarding-appearance-section" aria-labelledby="onboarding-appearance-title">
                            <h2 id="onboarding-appearance-title" class="onboarding-section-title">@Localizer["Settings_Appearance"]</h2>
                            <div class="choice-grid choice-grid-three" role="group" aria-labelledby="onboarding-appearance-title">
                                <button type="button"
                                        id="onboarding-theme-system"
                                        class="choice-button @(_draft.Theme == ThemePreference.System ? "active" : null)"
                                        aria-pressed="@(_draft.Theme == ThemePreference.System)"
                                        @onclick="() => SelectTheme(ThemePreference.System)">
                                    @Localizer["Settings_AppearanceSystem"]
                                </button>
                                <button type="button"
                                        id="onboarding-theme-light"
                                        class="choice-button @(_draft.Theme == ThemePreference.Light ? "active" : null)"
                                        aria-pressed="@(_draft.Theme == ThemePreference.Light)"
                                        @onclick="() => SelectTheme(ThemePreference.Light)">
                                    @Localizer["Settings_AppearanceLight"]
                                </button>
                                <button type="button"
                                        id="onboarding-theme-dark"
                                        class="choice-button @(_draft.Theme == ThemePreference.Dark ? "active" : null)"
                                        aria-pressed="@(_draft.Theme == ThemePreference.Dark)"
                                        @onclick="() => SelectTheme(ThemePreference.Dark)">
                                    @Localizer["Settings_AppearanceDark"]
                                </button>
                            </div>
                        </section>

                        <div class="onboarding-actions">
                            <button type="button"
                                    id="onboarding-continue-button"
                                    class="button button-primary onboarding-continue-button"
                                    @onclick="AdvanceToNextStep">
                                @Localizer["Common_Continue"]
                            </button>
                        </div>
                    </div>
                    break;

                case OnboardingStep.DisplayName:
                    <DisplayNameStep DisplayName="@_draft.DisplayName"
                                     OnDisplayNameChanged="HandleDisplayNameChanged"
                                     OnContinue="AdvanceToNextStep"
                                     OnBack="GoToPreviousStep" />
                    break;

                case OnboardingStep.Workflow:
                    <WorkflowStep OnContinue="AdvanceToNextStep" OnBack="GoToPreviousStep" />
                    break;

                case OnboardingStep.OnlineLookup:
                    <OnlineLookupStep OnlineLookupConsent="@_draft.OnlineLookupConsent"
                                      OnConsentChanged="HandleOnlineLookupConsentChanged"
                                      OnContinue="AdvanceToNextStep"
                                      OnBack="GoToPreviousStep" />
                    break;

                case OnboardingStep.EnhancedTermRecognition:
                    <EnhancedTermRecognitionStep EnhancedTermRecognitionEnabled="@_draft.EnhancedTermRecognitionEnabled"
                                                 OnEnhancedTermRecognitionChanged="HandleEnhancedTermRecognitionChanged"
                                                 OnContinue="AdvanceToNextStep"
                                                 OnBack="GoToPreviousStep" />
                    break;

                case OnboardingStep.Practice:
                    <PracticeStep CardDirection="@_draft.CardDirection"
                                  LearningMode="@_draft.LearningMode"
                                  OnCardDirectionChanged="HandleCardDirectionChanged"
                                  OnLearningModeChanged="HandleLearningModeChanged"
                                  OnContinue="AdvanceToNextStep"
                                  OnBack="GoToPreviousStep" />
                    break;

                case OnboardingStep.DailyPace:
                    <DailyPaceStep PreparationLimit="@_draft.PreparationLimit"
                                   OnPreparationLimitChanged="HandlePreparationLimitChanged"
                                   OnContinue="AdvanceToNextStep"
                                   OnBack="GoToPreviousStep" />
                    break;

                case OnboardingStep.LearningDayTiming:
                    <LearningDayTimingStep LearningTimezoneMode="@_draft.LearningTimezoneMode"
                                           ExplicitLearningTimezoneId="@_draft.ExplicitLearningTimezoneId"
                                           LearningDayCutoffMinutes="@_draft.LearningDayCutoffMinutes"
                                           OnTimezoneChanged="HandleTimezoneChanged"
                                           OnCutoffMinutesChanged="HandleCutoffMinutesChanged"
                                           OnContinue="AdvanceToNextStep"
                                           OnBack="GoToPreviousStep" />
                    break;

                case OnboardingStep.Summary:
                    <SummaryStep Draft="@_draft"
                                 ErrorMessage="@_finishErrorMessage"
                                 OnFinish="FinishOnboardingAsync"
                                 OnBack="GoToPreviousStep" />
                    break;

                default:
                    <div class="onboarding-step onboarding-step-shell">
                        <h1 class="onboarding-title">@Localizer["Onboarding_WelcomeTitle"]</h1>
                        <div class="onboarding-actions">
                            <button type="button"
                                    id="onboarding-back-button"
                                    class="button button-secondary onboarding-back-button"
                                    @onclick="GoToPreviousStep">
                                @Localizer["Common_Back"]
                            </button>
                        </div>
                    </div>
                    break;
            }
        </div>
    </main>
</div>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private OnboardingStep _currentStep = OnboardingStepPolicy.FirstStep;
    private OnboardingDraft _draft = OnboardingDraftPolicy.CreateDefault();
    private string _selectedLanguagePreference = LanguagePreferencePolicy.SystemPreferenceCode;
    private string _detectedDeviceCultureName = string.Empty;
    private DeviceLanguageClassification _deviceLanguageClassification =
        new(false, LanguagePreferencePolicy.EnglishLanguageCode);
    private string? _finishErrorMessage;

    protected override void OnInitialized()
    {
        if (OnboardingStateStore.GetState() == OnboardingState.Required)
        {
            OnboardingStateStore.SetState(OnboardingState.InProgress);
        }

        var savedStep = OnboardingProgressStore.GetCurrentStep();
        if (savedStep is not null && OnboardingStepPolicy.TryNormalize((int)savedStep.Value, out var normalized))
        {
            _currentStep = normalized;
        }
        else
        {
            _currentStep = OnboardingStepPolicy.FirstStep;
        }

        var draftResult = OnboardingDraftStore.GetDraft();
        if (draftResult.Status == OnboardingDraftStatus.Valid && draftResult.Draft is not null)
        {
            _draft = draftResult.Draft;
        }
        else
        {
            _draft = OnboardingDraftPolicy.CreateDefault();
            OnboardingDraftStore.Save(_draft);
        }

        LanguageSelection.ApplyPreviewLanguage(_draft.UiLanguage);
        ThemeService.ApplyPreviewPreference(_draft.Theme);

        SyncSelectedLanguagePreference();

        if (string.Equals(_draft.UiLanguage, LanguagePreferencePolicy.SystemPreferenceCode, StringComparison.OrdinalIgnoreCase))
        {
            RefreshDeviceCultureStatus();
        }

        LanguageSelection.UiLanguageChanged += OnUiLanguageChanged;
    }

    public void Dispose()
    {
        LanguageSelection.UiLanguageChanged -= OnUiLanguageChanged;
    }

    private void HandleLanguagePreferenceChanged()
    {
        SetLanguage(_selectedLanguagePreference);
    }

    private void SyncSelectedLanguagePreference()
    {
        _selectedLanguagePreference = _draft.UiLanguage;
    }

    private void SetLanguage(string languageCode)
    {
        LanguageSelection.ApplyPreviewLanguage(languageCode);
        UpdateDraft(_draft with { UiLanguage = languageCode });
        SyncSelectedLanguagePreference();

        if (string.Equals(_draft.UiLanguage, LanguagePreferencePolicy.SystemPreferenceCode, StringComparison.OrdinalIgnoreCase))
        {
            RefreshDeviceCultureStatus();
        }
    }

    private void SelectTheme(ThemePreference preference)
    {
        ThemeService.ApplyPreviewPreference(preference);
        UpdateDraft(_draft with { Theme = preference });
    }

    private string DetectedDeviceCultureCode =>
        string.IsNullOrWhiteSpace(_detectedDeviceCultureName)
            ? "?"
            : _detectedDeviceCultureName.Trim();

    private string GetDetectedDeviceCultureDisplayName()
    {
        try
        {
            return CultureInfo.GetCultureInfo(DetectedDeviceCultureCode.Replace('_', '-')).DisplayName;
        }
        catch (CultureNotFoundException)
        {
            return DetectedDeviceCultureCode;
        }
    }

    private void RefreshDeviceCultureStatus()
    {
        _detectedDeviceCultureName = DeviceCultureProvider.GetDeviceCultureName();
        _deviceLanguageClassification = LanguagePreferencePolicy.ClassifyDeviceCulture(_detectedDeviceCultureName);
    }

    private void UpdateDraft(OnboardingDraft newDraft)
    {
        _draft = newDraft;
        OnboardingDraftStore.Save(_draft);
    }

    private void HandleDisplayNameChanged(string? name)
    {
        UpdateDraft(_draft with { DisplayName = name });
    }

    private void HandleOnlineLookupConsentChanged(bool? consent)
    {
        UpdateDraft(_draft with { OnlineLookupConsent = consent });
    }

    private void HandleEnhancedTermRecognitionChanged(bool enabled)
    {
        UpdateDraft(_draft with { EnhancedTermRecognitionEnabled = enabled });
    }

    private void HandleCardDirectionChanged(CardDirectionPreference cardDirection)
    {
        UpdateDraft(_draft with { CardDirection = cardDirection });
    }

    private void HandleLearningModeChanged(LearningMode learningMode)
    {
        UpdateDraft(_draft with { LearningMode = learningMode });
    }

    private void HandlePreparationLimitChanged(int limit)
    {
        UpdateDraft(_draft with { PreparationLimit = limit });
    }

    private void HandleTimezoneChanged((LearningTimezoneMode Mode, string? ExplicitId) timezone)
    {
        UpdateDraft(_draft with
        {
            LearningTimezoneMode = timezone.Mode,
            ExplicitLearningTimezoneId = timezone.ExplicitId
        });
    }

    private void HandleCutoffMinutesChanged(int cutoffMinutes)
    {
        UpdateDraft(_draft with { LearningDayCutoffMinutes = cutoffMinutes });
    }

    private void AdvanceToNextStep()
    {
        if (_currentStep == OnboardingStep.OnlineLookup && _draft.OnlineLookupConsent is null)
        {
            return;
        }

        OnboardingDraftStore.Save(_draft);
        if (OnboardingStepPolicy.TryGetNext(_currentStep, out var nextStep))
        {
            _currentStep = nextStep;
            OnboardingProgressStore.SetCurrentStep(_currentStep);
        }
    }

    private void GoToPreviousStep()
    {
        OnboardingDraftStore.Save(_draft);
        if (OnboardingStepPolicy.TryGetPrevious(_currentStep, out var prevStep))
        {
            _currentStep = prevStep;
            OnboardingProgressStore.SetCurrentStep(_currentStep);
        }
    }

    private async Task FinishOnboardingAsync()
    {
        _finishErrorMessage = null;
        OnboardingDraftStore.Save(_draft);

        if (!_draft.OnlineLookupConsent.HasValue)
        {
            _finishErrorMessage = Localizer["Settings_SaveError"];
            return;
        }

        bool success = false;
        try
        {
            success = CompletionService.CompleteOnboarding(_draft);
        }
        catch
        {
            success = false;
        }

        if (success || OnboardingStateStore.GetState() == OnboardingState.Completed)
        {
            if (OnCompleted.HasDelegate)
            {
                await OnCompleted.InvokeAsync();
            }
        }
        else
        {
            _finishErrorMessage = Localizer["Settings_SaveError"];
            LanguageSelection.ApplyPreviewLanguage(_draft.UiLanguage);
            ThemeService.ApplyPreviewPreference(_draft.Theme);
        }
    }

    private void OnUiLanguageChanged(object? sender, EventArgs e)
    {
        SyncSelectedLanguagePreference();
        _ = InvokeAsync(StateHasChanged);
    }
}
