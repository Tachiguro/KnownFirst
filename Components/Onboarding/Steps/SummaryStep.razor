@namespace KnownFirst.Components.Onboarding.Steps
@using System.Globalization
@using KnownFirst.Core.Language
@using KnownFirst.Core.Settings
@using KnownFirst.Services.Time
@inject IStringLocalizer<SharedResource> Localizer

<div class="onboarding-step onboarding-summary-step">
    <h1 class="onboarding-title" id="onboarding-summary-title">@Localizer["Onboarding_SummaryTitle"]</h1>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <p class="setting-feedback setting-feedback-error" role="alert">@ErrorMessage</p>
    }

    <div class="onboarding-card summary-card" role="region" aria-labelledby="onboarding-summary-title">
        <dl class="summary-list">
            <div class="summary-item">
                <dt>@Localizer["Settings_UILanguage"]</dt>
                <dd>@GetLanguagePreferenceDisplayName()</dd>
            </div>
            <div class="summary-item">
                <dt>@Localizer["Settings_Appearance"]</dt>
                <dd>@GetAppearancePreferenceDisplayName()</dd>
            </div>
            <div class="summary-item">
                <dt>@Localizer["Settings_DisplayName"]</dt>
                <dd>@(Draft.DisplayName ?? Localizer["Onboarding_SummaryDisplayNameNotSet"])</dd>
            </div>
            <div class="summary-item">
                <dt>@Localizer["Settings_OnlineDictionary"]</dt>
                <dd>@Localizer[Draft.OnlineLookupConsent == true ? "Settings_EnhancedTermRecognitionOn" : "Settings_EnhancedTermRecognitionOff"]</dd>
            </div>
            <div class="summary-item">
                <dt>@Localizer["Settings_EnhancedTermRecognition"]</dt>
                <dd>@Localizer[Draft.EnhancedTermRecognitionEnabled ? "Settings_EnhancedTermRecognitionOn" : "Settings_EnhancedTermRecognitionOff"]</dd>
            </div>
            <div class="summary-item">
                <dt>@Localizer["Settings_CardDirection"]</dt>
                <dd>@GetCardDirectionLabel(Draft.CardDirection)</dd>
            </div>
            <div class="summary-item">
                <dt>@Localizer["Settings_LearningMode"]</dt>
                <dd>@GetLearningModeLabel(Draft.LearningMode)</dd>
            </div>
            <div class="summary-item">
                <dt>@Localizer["Settings_PreparationLimit"]</dt>
                <dd>@Draft.PreparationLimit</dd>
            </div>
            <div class="summary-item">
                <dt>@Localizer["Settings_LearningTimezone"]</dt>
                <dd>@GetTimezoneLabel()</dd>
            </div>
            <div class="summary-item">
                <dt>@Localizer["Settings_LearningDayCutoff"]</dt>
                <dd>@GetCutoffLabel(Draft.LearningDayCutoffMinutes)</dd>
            </div>
        </dl>
        <p id="onboarding-summary-settings-notice" class="setting-help">@Localizer["Onboarding_SummarySettingsNotice"]</p>
    </div>

    <div class="onboarding-actions">
        <button type="button"
                id="onboarding-finish-button"
                class="button button-primary onboarding-continue-button"
                disabled="@(!Draft.OnlineLookupConsent.HasValue)"
                @onclick="OnFinish">
            @Localizer["Onboarding_FinishSetup"]
        </button>
        <button type="button"
                id="onboarding-summary-back-button"
                class="button button-secondary onboarding-back-button"
                @onclick="OnBack">
            @Localizer["Common_Back"]
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public OnboardingDraft Draft { get; set; } = null!;
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnFinish { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private string GetLanguagePreferenceDisplayName()
    {
        if (string.Equals(Draft.UiLanguage, LanguagePreferencePolicy.SystemPreferenceCode, StringComparison.OrdinalIgnoreCase))
        {
            return Localizer["Settings_UILanguageSystem"];
        }

        return Draft.UiLanguage switch
        {
            LanguagePreferencePolicy.GermanLanguageCode => Localizer["Settings_German"],
            LanguagePreferencePolicy.RussianLanguageCode => Localizer["Settings_Russian"],
            _ => Localizer["Settings_English"]
        };
    }

    private string GetAppearancePreferenceDisplayName() => Draft.Theme switch
    {
        ThemePreference.Light => Localizer["Settings_AppearanceLight"],
        ThemePreference.Dark => Localizer["Settings_AppearanceDark"],
        _ => Localizer["Settings_AppearanceSystem"]
    };

    private string GetCardDirectionLabel(CardDirectionPreference preference) => preference switch
    {
        CardDirectionPreference.TermToMeaning => Localizer["Settings_CardDirectionTermToMeaning"],
        CardDirectionPreference.MeaningToTerm => Localizer["Settings_CardDirectionMeaningToTerm"],
        _ => Localizer["Settings_CardDirectionBoth"]
    };

    private string GetLearningModeLabel(LearningMode mode) => mode switch
    {
        LearningMode.Reading => Localizer["Settings_LearningModeReading"],
        LearningMode.Typing => Localizer["Settings_LearningModeTyping"],
        _ => Localizer["Settings_LearningModeAutomatic"]
    };

    private string GetTimezoneLabel()
    {
        if (Draft.LearningTimezoneMode == LearningTimezoneMode.Explicit
            && LearningTimezoneCatalog.ContainsTimezoneId(Draft.ExplicitLearningTimezoneId))
        {
            var option = LearningTimezoneCatalog.Options.FirstOrDefault(o => o.TimezoneId == Draft.ExplicitLearningTimezoneId);
            if (option is not null)
            {
                string cityName = Localizer[option.CityResourceKey];
                try
                {
                    var tz = TimeZoneInfo.FindSystemTimeZoneById(option.TimezoneId);
                    return LearningTimezoneLabelFormatter.FormatOptionLabel(tz, DateTime.UtcNow, cityName);
                }
                catch
                {
                    return cityName;
                }
            }
        }

        return Localizer["Onboarding_SummaryLearningTimezoneSystem"];
    }

    private static string GetCutoffLabel(int cutoffMinutes)
    {
        var h = cutoffMinutes / 60;
        var m = cutoffMinutes % 60;
        return $"{h:D2}:{m:D2}";
    }
}
