@namespace KnownFirst.Components.Onboarding.Steps
@inject IStringLocalizer<SharedResource> Localizer

<div class="onboarding-step onboarding-online-lookup-step">
    <h1 class="onboarding-title" id="onboarding-online-lookup-title">@Localizer["Onboarding_OnlineLookupTitle"]</h1>
    <p class="onboarding-concept">@Localizer["Onboarding_OnlineLookupDescription"]</p>

    <section class="onboarding-card" aria-labelledby="onboarding-online-lookup-title">
        <div class="onboarding-service-highlights" role="list">
            <p class="setting-help" role="listitem">
                <strong>Wiktionary:</strong> @Localizer["Onboarding_OnlineLookupServiceWiktionary"]
            </p>
            <p class="setting-help" role="listitem">
                <strong>Wikipedia:</strong> @Localizer["Onboarding_OnlineLookupServiceWikipedia"]
            </p>
            <p class="setting-help" role="listitem">
                @Localizer["Onboarding_OnlineLookupPrivacyNotice"]
            </p>
        </div>

        <div class="choice-grid choice-grid-two" role="group" aria-labelledby="onboarding-online-lookup-title">
            <button type="button"
                    id="onboarding-online-consent-enable-button"
                    class="choice-button @(OnlineLookupConsent == true ? "active" : null)"
                    aria-pressed="@(OnlineLookupConsent == true)"
                    @onclick="EnableOnlineConsent">
                @Localizer["Onboarding_OnlineLookupEnable"]
            </button>
            <button type="button"
                    id="onboarding-online-consent-disable-button"
                    class="choice-button @(OnlineLookupConsent == false ? "active" : null)"
                    aria-pressed="@(OnlineLookupConsent == false)"
                    @onclick="DisableOnlineConsent">
                @Localizer["Onboarding_OnlineLookupKeepDisabled"]
            </button>
        </div>
    </section>

    <div class="onboarding-actions">
        <button type="button"
                id="onboarding-online-lookup-continue-button"
                class="button button-primary onboarding-continue-button"
                disabled="@(OnlineLookupConsent is null)"
                @onclick="HandleContinue">
            @Localizer["Common_Continue"]
        </button>
        <button type="button"
                id="onboarding-online-lookup-back-button"
                class="button button-secondary onboarding-back-button"
                @onclick="OnBack">
            @Localizer["Common_Back"]
        </button>
    </div>
</div>

@code {
    [Parameter] public bool? OnlineLookupConsent { get; set; }
    [Parameter] public EventCallback<bool?> OnConsentChanged { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private async Task EnableOnlineConsent()
    {
        if (OnConsentChanged.HasDelegate)
        {
            await OnConsentChanged.InvokeAsync(true);
        }
    }

    private async Task DisableOnlineConsent()
    {
        if (OnConsentChanged.HasDelegate)
        {
            await OnConsentChanged.InvokeAsync(false);
        }
    }

    private async Task HandleContinue()
    {
        if (OnlineLookupConsent is not null)
        {
            await OnContinue.InvokeAsync();
        }
    }
}
